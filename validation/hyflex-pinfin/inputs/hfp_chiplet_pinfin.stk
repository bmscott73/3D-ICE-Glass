// 3D-ICE-Glass | hfp_chiplet_pinfin.stk | generated from active statements
// SPDX-License-Identifier: CC-BY-4.0
// Canvas 26100 x 17400 um; grid 100 x 100 um.
// Source power: first 140.7 W; range 140.7..140.7 W; 1 sample(s).
// External faces: adiabatic; coolant channel is the heat-removal boundary.
// Embedded cooling pinfin: flow/velocity=1000000.0 um/s; inlet=300.0 K; h=engine correlation.
// Temperatures in emulator outputs are kelvin; time is seconds.
// Model data: CC-BY-4.0. References and observation planes: checkpoint README / docs/case-index.md.

material SILICON :
    thermal conductivity     1.30e-04 ;
    volumetric heat capacity 1.628e-12 ;

material GLASS :
    thermal conductivity     1.40e-06 ;
    volumetric heat capacity 1.60e-12 ;

material COPPER :
    thermal conductivity     4.00e-04 ;
    volumetric heat capacity 3.45e-12 ;

material SINTER_AG :
    thermal conductivity     2.00e-04 ;
    volumetric heat capacity 2.50e-12 ;

material TGV_GLASS_COMPOSITE :
    thermal conductivity     1.00e-06, 1.00e-06, 7.9204e-05 ;
    volumetric heat capacity 1.96e-12 ;

pinfin :
    height 100 ;
    pin diameter 50 ;
    pin pitch 100 ;
    pin distribution inline ;
    pin material COPPER ;
    darcy velocity 1.00e+06 ;
    coolant volumetric heat capacity 4.18e-12 ;
    coolant incoming temperature 300.0 ;

dimensions :
    chip length 26100, width 17400 ;
    cell length 100,   width 100 ;
    non-uniform false ;

layer GLASS_COVER_L :
    height   200 ;
    material GLASS ;

layer TGVS_L :
    height   100 ;
    material TGV_GLASS_COMPOSITE ;

layer ATTACH_L :
    height   20 ;
    material SINTER_AG ;

layer GLASS_BASE_L :
    height   200 ;
    material GLASS ;

die PIM_D :
    layer   50 SILICON ;
    source   5 SILICON ;
    layer   45 SILICON ;

stack :
    layer   GLASS_COVER  GLASS_COVER_L ;
    channel PINS ;
    layer   TGVS         TGVS_L ;
    layer   ATTACH       ATTACH_L ;
    die     PIM          PIM_D  floorplan "hfp_chiplet_duty.flp" ;
    layer   GLASS_BASE   GLASS_BASE_L ;

solver :
    steady ;
    initial temperature 300.0 ;
    numofcores 2 ;

output :
    Tflp(     PIM,  "outputs/chiplet_pinfin_max.txt", maximum, final ) ;
    Tflp(     PIM,  "outputs/chiplet_pinfin_avg.txt", average, final ) ;
    Tmap(     PIM,  "outputs/chiplet_pinfin_tmap.txt", final ) ;
    Tmap(     PINS, "outputs/chiplet_pinfin_cav.txt", final ) ;

    Tcoolant( PINS, "outputs/chiplet_pinfin_outlet.txt", maximum, final ) ;
