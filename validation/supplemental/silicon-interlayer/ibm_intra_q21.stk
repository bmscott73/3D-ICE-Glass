// ibm_intra_100W.stk -- Validation row: Si interlayer microchannel (intra-chip cooling)
// Target: Miyazawa, Mori, Jain, Farooq, Hisada (IBM Research), "CFD Simulation
//   Analysis of Inter/Intra Chip Liquid Cooling for 3D Stacked ICs," ITherm 2023,
//   DOI 10.1109/ITHERM55368.2023.10177558. ANSYS Fluent 2022 R1 reference.
// POINT-CHECK targets (Table III, 100 W/chip, 0.3 g/s, DI water 20 C inlet):
//   Top chip Tmax = 79.5 C (352.65 K) | Bottom chip Tmax = 84.7 C (357.85 K)
// Secondary signatures: BC hotter than TC; hotspot at outlet end (x = chip length).
//
// Geometry per reference: two 10x10x0.15 mm chips (active 5 um + SiO2 5 um),
//   backside channels 75 um wide / 75 um deep / 150 um pitch in EACH chip;
//   Cu lid 30x30x2 mm + 24 um TIM (k=4); chip-to-chip interconnect 25 um (k=5);
//   chip-to-substrate 75 um (k=5); organic substrate 1 mm (k=0.5).
// Modeled footprint 10000 x 9975 um: 9975 = 67 walls + 66 channels at exact
//   75-um columns (0.25% trim from 10 mm; power held at 100 W/chip).
//
// FLAGGED ASSUMPTIONS (see README):
//   1. Flow accounting: reference states "0.3 g/s"; THIS FILE assumes 0.3 g/s PER
//      CHANNEL LAYER (18 ml/min each). Caloric analysis supports this reading.
//      Variant ibm_intra_100W_flow9.stk assumes a 50/50 split (9 ml/min each).
//   2. Top boundary: cold plate h = 10000 W/m2K stated for the baseline case is
//      assumed retained; 30x30 mm lid overhang folded into an effective HTC over
//      the chip footprint via fin correction (eta = 0.715, x6.72): 6.72e-8 W/um2K.
//      Delete the heat sink block for the adiabatic-top bound.
//   3. Channel HTC (4RM requires declared values): Hausen combined-entry,
//      Re = 60.6, Nu = 3.86, h = 3.08e-8 W/um2K on side/top/bottom.
// Power discipline: .flp sums = 200.0 W total (100 + 100).

material SILICON :
   thermal conductivity     1.47e-4 ;    // 147 W/mK per reference Table II
   volumetric heat capacity 1.628e-12 ;

material COPPER :
   thermal conductivity     3.85e-4 ;    // 385 W/mK per reference
   volumetric heat capacity 3.45e-12 ;

material TIM4 :
   thermal conductivity     4.00e-6 ;    // 4 W/mK per reference
   volumetric heat capacity 2.00e-12 ;

material INTERCONNECT :
   thermal conductivity     5.00e-6 ;    // 5 W/mK per reference
   volumetric heat capacity 2.00e-12 ;

material SIO2 :
   thermal conductivity     1.40e-6 ;    // 1.4 W/mK per reference
   volumetric heat capacity 1.70e-12 ;

material SUBSTRATE :
   thermal conductivity     5.00e-7 ;    // 0.5 W/mK per reference
   volumetric heat capacity 2.00e-12 ;

top heat sink :
   heat transfer coefficient 1.292e-08 ;  // CALIBRATED vs Table III cold-plate baseline (12,924 W/m2K)
   temperature               293.15 ;    // 20 C ambient (= coolant inlet; not stated, assumed)

microchannel 4rm :
   height 75 ;
   channel length    75 ;
   wall    length    75 ;
   first wall length 75 ;
   wall material SILICON ;
   coolant flow rate 21 ;                // flow sweep: 21 ml/min per layer
   coolant heat transfer coefficient side   3.08e-08 ,
                                     top    3.08e-08 ,
                                     bottom 3.08e-08 ;
   coolant volumetric heat capacity 4.172e-12 ;
   coolant incoming temperature 293.15 ; // 20 C DI water per reference


dimensions :
   chip length 9975,  width 10000 ;     // LENGTH = transverse channel-tiling axis:
   cell length 75,    width 100 ;       //   9975 = 75 first wall + 66 x (75+75); cell length
   non-uniform false ;                  //   MUST equal the 75-um column pitch. Flow runs
                                        //   along WIDTH; cell width free (100; refine to 50).

layer CU_LID :
   height   2000 ;
   material COPPER ;

layer TIM_L :
   height   24 ;
   material TIM4 ;

layer C2C :
   height   25 ;
   material INTERCONNECT ;

layer C2S :
   height   75 ;
   material INTERCONNECT ;

layer SUB :
   height   1000 ;
   material SUBSTRATE ;


die TOP_DIE :
   layer  65 SILICON ;                   // remaining bulk under backside channels
   source  5 SILICON ;                   // active face down (flip-chip)
   layer   5 SIO2 ;

die BOT_DIE :
   layer  65 SILICON ;
   source  5 SILICON ;
   layer   5 SIO2 ;

stack :
   layer   LID     CU_LID ;
   layer   TIML    TIM_L ;
   channel CH_TOP ;                      // channels in top chip backside
   die     TCHIP   TOP_DIE   floorplan "tchip_ibm.flp" ;
   layer   C2CL    C2C ;
   channel CH_BOT ;                      // channels in bottom chip backside
   die     BCHIP   BOT_DIE   floorplan "bchip_ibm.flp" ;
   layer   C2SL    C2S ;
   layer   SUBL    SUB ;

solver :
   steady ;
   initial temperature 293.15 ;
   numofcores 12 ;

output :
   Tflp(     TCHIP,  "outputs-ibm4/ibm_intra_q21_tc_max.txt",  maximum, final ) ;
   Tflp(     TCHIP,  "outputs-ibm4/ibm_intra_q21_tc_avg.txt",  average, final ) ;
   Tflp(     BCHIP,  "outputs-ibm4/ibm_intra_q21_bc_max.txt",  maximum, final ) ;
   Tflp(     BCHIP,  "outputs-ibm4/ibm_intra_q21_bc_avg.txt",  average, final ) ;
   Tcoolant( CH_TOP, "outputs-ibm4/ibm_intra_q21_out_top.txt", maximum, final ) ;
   Tcoolant( CH_BOT, "outputs-ibm4/ibm_intra_q21_out_bot.txt", maximum, final ) ;
