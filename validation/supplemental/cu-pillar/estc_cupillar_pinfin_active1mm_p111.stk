// ============================================================
// 3D-ICE model: ESTC direct-contact Cu-pillar pin-fin validation vehicle
// Corrected active-region model after Ruposri clarification
//
// Target reference:
//   - Active Cu-pillar cooling region: 1 mm x 1 mm
//   - Heater footprint: 1 mm x 1 mm
//   - Peak heat flux: 502 W/cm^2 => 5.02 W
//   - Flow rate: 36 mL/min DI water through full test vehicle/chamber
//   - Measured diode/junction temperature: 78.6 C = 351.75 K
//   - ANSYS/Icepak target: ~78 C = 351.15 K
//   - Pressure drop: 8.42 psi = 58.1 kPa
//   - Cu pillars: 81 active pillars, 9 x 9 array
//   - Physical pillars: 50 um diameter, 100 um pitch, 100 um height
//   - RDL thickness clarified by author: ~6 um
//   - ANSYS did not include DAF/TIM and did not impose HTC/Darcy BC;
//     it used explicit fluid domains with full conjugate heat transfer.
//
// Compact 3D-ICE interpretation:
//   - 3D-ICE pinfin is a homogenized cavity, not explicit 81-pillar CAD.
//   - Active domain is reduced to 1 mm x 1 mm so the pin-fin layer is only
//     applied over the author-confirmed active cooling region.
//   - Effective pitch = sqrt(1e6/81) = 111.11 um to preserve 81 pins/mm^2.
//     A physical-pitch sensitivity run with pitch=100 um is also reasonable.
//   - Darcy velocity is retained at 2.0 m/s as the local superficial velocity
//     implied by 36 mL/min distributed across the 3 mm-wide, 100 um-high
//     chamber. If the full 36 mL/min is forced through only the 1 mm active
//     lane, use 6.0e6 um/s instead. Treat this as a calibration/sensitivity
//     parameter because ANSYS did not use a porous/Darcy model.
// ============================================================

// ============================================================
// 1. MATERIALS
// ============================================================

material SILICON :
    thermal conductivity    1.30e-04 ;
    volumetric heat capacity 1.63e-12 ;

material GLASS :
    thermal conductivity    1.00e-06 ;
    volumetric heat capacity 1.60e-12 ;

material COPPER :
    thermal conductivity    4.00e-04 ;
    volumetric heat capacity 3.45e-12 ;

material ABF :
    thermal conductivity    3.00e-07 ;
    volumetric heat capacity 1.60e-12 ;

// ============================================================
// 2. LIQUID-COOLED PIN-FIN CAVITY
// ============================================================

pinfin :
    height 100 ;
    pin diameter 50 ;
    pin pitch 111.11 ;
    pin distribution inline ;
    pin material COPPER ;
    darcy velocity 7.50e+05 ; // 2.00e+06
    coolant volumetric heat capacity 4.18e-12 ;
    coolant incoming temperature 295.15 ;

// ============================================================
// 3. DIMENSIONS
// Active 1 mm x 1 mm validation domain. 50 um cells give 20 x 20 grid.
// ============================================================

dimensions :
    chip length 1000, width 1000 ;
    cell length 50, width 50 ;
    non-uniform false ;

// ============================================================
// 4. PASSIVE LAYERS
// ============================================================

layer GLASS1_COVER :
    height 200 ;
    material GLASS ;

layer CU_RDL :
    height 6 ;
    material COPPER ;

layer ABF_ELECTRICAL :
    height 30 ;
    material ABF ;

// ============================================================
// 5. DIE
// 300 um TTC assumption. Source is at cooling-facing top side.
// DAF/TIM omitted to match author clarification for ANSYS simulations.
// ============================================================

die TTC_DIE :
    source 10 SILICON ;
    layer 290 SILICON ;

// ============================================================
// 6. STACK ORDER: top -> bottom
// ============================================================

stack :
    layer COVER GLASS1_COVER ;
    channel PINS ;
    layer RDL CU_RDL ;
    die TTC TTC_DIE floorplan "estc_cupillar_active1mm_p111.flp" ;
    layer ABF_BOTTOM ABF_ELECTRICAL ;

// ============================================================
// 7. ANALYSIS
// ============================================================

solver :
    steady ;
    initial temperature 295.15 ;
    numofcores 12 ;

// ============================================================
// 8. OUTPUTS
// Compare Tflp max to ANSYS ~351.15 K and measured diode/Tj 351.75 K.
// ============================================================

output :
    Tflp( TTC, "outputs2/cupillar_active1mm_p111_tj_max_K_7.5.txt", maximum, final ) ;
    Tflp( TTC, "outputs2/cupillar_active1mm_p111_tj_avg_K_7.5.txt", average, final ) ;
    Tmap( TTC, "outputs2/cupillar_active1mm_p111_ttc_tmap_K_7.5.txt", final ) ;
    Tmap( RDL, "outputs2/cupillar_active1mm_p111_rdl_tmap_K_7.5.txt", final ) ;
    Tcoolant( PINS, "outputs2/cupillar_active1mm_p111_outlet_coolant_K_7.5.txt", maximum, final ) ;
