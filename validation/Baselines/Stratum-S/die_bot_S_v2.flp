// ============================================================
// 3D-ICE Floorplan: die_bot_S_v2.flp
// Stratum-S v2 -- BOTTOM die tier (NMP logic die, under the Mono3D DRAM)
//
// Block boundaries are IDENTICAL to die_top_S_v2.flp so the two Tmap outputs
// are cell-aligned and can be differenced directly.
//
// Only LOGIC0 is active. Everything else in this tier is passive.
//
// KNOWN LIMITATION (unavoidable in 3D-ICE, document it in the paper):
//   3D-ICE assigns material per LAYER, not per floorplan element. The region of
//   this tier under GPU0 and under the guard gap is therefore modelled as
//   silicon, when physically there is no second-tier die there at all -- just
//   interposer, underfill and air. This creates a fictitious lateral conduction
//   path in the bottom tier.
//   Why it is tolerable HERE: the bottom of the stack is adiabatic and the cold
//   plate is above, so this tier carries very little lateral flux. The 2000 um
//   guard gap (~2.7x the 0.73 um-scale die spreading length) bounds what leaks
//   across. Quantify it once with the bounding run described in the README.
//
// LOGIC0 power: 42.67 W.
//   Stratum Section 6.2.3: "The total power of the logic die is 42.67 W,
//   including compute, on-chip communication, and logic-die memory access,
//   under the 45W power budget." Table 3 lists 43 W peak power.
//   v1 used 40 W, which was 6% low.
//
// Power density:
//   LOGIC0 : 42.67 W / 121.00 mm^2 = 35.3 W/cm^2
// ============================================================

// ---- left margin ----

FILL_LEFT :
    position  0, 0 ;
    dimension 2000, 31800 ;
    power values 0 ;

// ---- Mono3D column: below the tile ----

FILL_M3D_BOT :
    position  2000, 0 ;
    dimension 11000, 10400 ;
    power values 0 ;

// ---- NMP logic tile (active), directly under MEM0 ----

LOGIC0 :
    position  2000, 10400 ;
    dimension 11000, 11000 ;
    power values 42.67 ;
    // Stratum Sec. 6.2.3 exact figure. Face-to-face Cu-Cu hybrid bonded to the
    // Mono3D DRAM die above, so this die's ACTIVE FACE POINTS UP -- see the
    // DIE_BOT_D source ordering in the .stk.

// ---- Mono3D column: above the tile ----

FILL_M3D_TOP :
    position  2000, 21400 ;
    dimension 11000, 10400 ;
    power values 0 ;

// ---- guard gap ----

FILL_GAP :
    position  13000, 0 ;
    dimension 2000, 31800 ;
    power values 0 ;

// ---- under the xPU column: NO second-tier die exists here ----

FILL_GPU_BOT :
    position  15000, 0 ;
    dimension 22600, 2000 ;
    power values 0 ;

FILL_UNDER_GPU :
    position  15000, 2000 ;
    dimension 22600, 27800 ;
    power values 0 ;
    // Physically this is interposer + underfill + air, NOT silicon.
    // 3D-ICE cannot vary material within a layer. See header limitation note.

FILL_GPU_TOP :
    position  15000, 29800 ;
    dimension 22600, 2000 ;
    power values 0 ;

// ---- right margin ----

FILL_RIGHT :
    position  37600, 0 ;
    dimension 2000, 31800 ;
    power values 0 ;
