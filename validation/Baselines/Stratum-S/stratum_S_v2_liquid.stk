// ============================================================
// 3D-ICE 4.0 Stack Description -- Stratum-S v2
// Configuration: A6000-class GA102 xPU + 1 Mono3D DRAM/NMP stack
//                on a glass interposer, direct-to-chip LIQUID cold plate.
// Solver: steady-state
//
// ------------------------------------------------------------
// WHAT CHANGED vs stratum_S_glass_liquid_toponly.stk
// ------------------------------------------------------------
// 1. ADDED A 2 mm Cu COLD-PLATE BASE (CP_BASE).
//    Originally applied the heat-sink HTC as a Robin BC directly onto 20 um of TIM.
//    Lateral spreading length sqrt(k*t/h) in the topmost conductive layer was
//    then only 0.73 mm, against a 5.5 mm Mono3D tile half-width so the
//    119.6 W/cm^2 column was effectively 1-D and took its full local dT.
//    A real cold plate has a Cu base with a 5.4 mm spreading length; the
//    Stratum paper's own HotSpot model (Sec. 6.2.2) used a 1 mm / 5000 W.m-1K-1
//    vapor chamber, i.e. 13.4 mm. The missing spreader was worth ~23 K on the
//    Mono3D hotspot and is the most likely single cause of a 3D-ICE/Icepak
//    divergence, because an Icepak user will draw the physical cold plate.
//
// 2. h RE-REFERENCED TO THE CONVECTIVE SIDE ONLY
//    v1's h = 2.78e-8 (27,800 W/m^2K) was a surrogate for the TOTAL die-to-water
//    resistance (0.0224 K/W over the canvas). With CP_BASE now explicit, h must
//    represent only the fins + water, not the whole path. See Sec. 2.
//
// 3. GPU0 MOVED TO THE TOP DIE TIER. v1 placed 151 um of fictitious silicon
//    (a passive Mono3D DRAM region + hybrid bond) between the xPU and the TIM.
//
// 4. FLIP-CHIP SOURCE PLACEMENT. Dies now carry an explicit 5 um source
//    sublayer at the correct face instead of a single uniform mid-plane node.
//    This also removes an Icepak parity ambiguity: both tools can now place the
//    source at the same physical depth.
//
// 5. INTERPOSER BROKEN OUT into TGV field / cavity placeholder / core, so the
//    microchannel and photonic variants are a substitution, not a rewrite.
//
// 6. Powers corrected: LOGIC0 40 -> 42.67 W (paper Sec. 6.2.3);
//    GPU0 300 -> 230 W (300 W is A6000 BOARD power, not GA102 die power).
//
// ============================================================
// 1. MATERIALS
// ============================================================

// Bulk silicon for both device tiers.
// NOTE: v1 used 100 W/mK ("LOGIC_MEM") while the HyFlexPIM model used 130.
// Unified at 130 here. Sensitivity across 100-148 W/mK is < 0.5 K in this stack.
material SILICON :
    thermal conductivity     1.30e-04 ;   // 130 W/(m.K)
    volumetric heat capacity 1.75e-12 ;

// BOUNDING MATERIAL for the Mono3D DRAM die -- NOT used in the default run.
// The Mono3D die is 1024 stacked DRAM tiers with interlayer dielectric, not
// bulk silicon.
// Because GPU0 shifts < 0.5 K under that change, the delta is effectively a
// pure Mono3D sensitivity. Expect roughly +4 K on MEM0.
material MONO3D_DRAM :
    thermal conductivity     3.00e-05 ;   // 30 W/(m.K)  pessimistic bound
    volumetric heat capacity 1.75e-12 ;

// TIM1. Bare-die flip-chip GPUs have NO integrated heat spreader, so the cooler
// contacts silicon directly through this layer. Typical GPU grease/putty
// 3-8 W/mK at a 20-75 um bond line.
material TIM :
    thermal conductivity     4.00e-06 ;   // 4 W/(m.K)
    volumetric heat capacity 4.00e-12 ;

material COPPER :
    thermal conductivity     4.00e-04 ;   // 400 W/(m.K)
    volumetric heat capacity 3.45e-12 ;

// Cu-Cu hybrid bond, 30% Cu area fraction: 0.3*400 + 0.7*1.4 = 121 W/mK.
// At 1 um thick this layer is thermally irrelevant (R" = 0.008 mm^2K/W).
// It is retained for structural fidelity only.
material HYBRID_BOND :
    thermal conductivity     1.21e-04 ;
    volumetric heat capacity 2.14e-12 ;

// Microbump + underfill composite between the bottom die and the interposer
// ~16% Cu-pillar/SnAg area fraction in underfill: 0.16*150 + 0.84*0.6 ~ 24 W/mK.
// Rounded down to 20 for conservatism
material UBUMP_UF :
    thermal conductivity     2.00e-05 ;   // 20 W/(m.K)
    volumetric heat capacity 2.50e-12 ;

// Fused silica / borosilicate glass core
material GLASS :
    thermal conductivity     1.40e-06 ;   // 1.4 W/(m.K)
    volumetric heat capacity 1.60e-12 ;

// Cu-TGV / glass composite. SAME parameters as the HyFlexPIM model so the two
// baselines stay consistent. f_Cu = 0.196 (ESTC dia-100/200 um geometry),
// k_z = 0.196*400 + 0.804*1.4 = 79.2 W/mK; lateral stays glass-like.
// The 57x k_z contrast between TGV fields and bare glass is the lateral
// heat-steering mechanism identified in the vertical-placement study.
material TGV_GLASS_COMPOSITE :
    thermal conductivity     1.00e-06, 1.00e-06, 7.9204e-05 ;
    volumetric heat capacity 1.96e-12 ;

// ============================================================
// 2. HEAT SINK  direct-to-chip liquid cold plate
// ============================================================
//
// h here is the CONVECTIVE side only (fin array + water). The Cu base is now an
// explicit layer
//
// Resistance budget at the default h, referenced to the 1259.3 mm^2 canvas:
//   R_conv  = 1/(40000 * 1.2593e-3)      = 0.0199 K/W
//   R_base  = 2e-3/(400 * 1.2593e-3)     = 0.0040 K/W
//   R_TIM   = 20e-6/4 / 628.28e-6 (@GPU) = 0.0080 K/W
//   spreading                            ~ 0.006 K/W
//   -> R_die->water ~ 0.038 K/W, i.e. a good direct-to-chip datacenter block.
//
//   4.00e-08  ->  40,000 W/m^2K   DEFAULT, premium direct-to-chip block
//
// Coolant reference temperature 300 K = 26.85 C. A real facility water loop runs
// 30-45 C inlet; add the offset at report time rather than changing it here, so
// this run stays directly comparable to the air variant.

top heat sink :
    heat transfer coefficient 4.08e-08 ; // 4.08e-08 commercial H200 liquid cold plate
    temperature 300 ;

// Bottom of the interposer is ADIABATIC (no bottom heat sink declared).
// Rationale, unchanged from v1: a single well-defined convective boundary means
// any cross-tool mismatch reflects solver behaviour, not BC interpretation.
// It is also the physical top-cooled case -- downward heat flow through 1.4 W/mK
// glass into an unattached substrate is < 0.5% of the total.
// For the composed system this becomes a real parallel path and must be revisited.

// ============================================================
// 3. DIMENSIONS
// ============================================================
// Canvas 39600 x 31800 um. Every block edge lies on a 200 um grid, so this
// model runs at either 100 or 200 um cells without re-tiling the floorplan.
//   100 um -> 396 x 318 = 125,928 cells/layer x 11 layers = 1.385 M nodes
//   200 um -> 198 x 159 =  31,482 cells/layer x 11 layers = 0.346 M nodes
// Run 200 um for iteration, then confirm at 100 um before reporting. Die-layer
// spreading length is ~0.73 mm = 7.3 cells at 100 um, 3.7 at 200 um -- the
// coarse grid is marginal for hotspot shape, adequate for block averages.

dimensions :
    chip length 39600, width 31800 ;
    cell length 100,   width 100 ;
    non-uniform false ;

// ============================================================
// 4. PASSIVE LAYERS
// ============================================================

layer CP_BASE_L :            // cold-plate base -- the spreader v1 was missing
    height   2000 ;
    material COPPER ;

layer TIM_L :                // TIM1, bare die to cold plate
    height   20 ;
    material TIM ;

layer HB_L :                 // Cu-Cu hybrid bond, DRAM die <-> logic die
    height   1 ;
    material HYBRID_BOND ;

layer UBUMP_L :              // microbump + underfill, bottom die -> interposer
    height   40 ;
    material UBUMP_UF ;

// glass interposer, broken out for composability

layer IPOSER_TGV_L :         // chip-side RDL (10 um) + Cu-TGV field (100 um)
    height   110 ;
    material TGV_GLASS_COMPOSITE ;

layer IPOSER_CAV_L :         // MICROCHANNEL CAVITY PLACEHOLDER -- solid glass rn
    height   100 ;           // To activate interlayer cooling, delete this layer,
    material GLASS ;         // uncomment the microchannel block in Sec. 5, and
                             // replace "layer IPOSER_CAV" with "channel IMCH" in
                             // the stack. Geometry and grid already accommodate it.

layer IPOSER_CORE_L :        // photonic plane (20 um) + structural glass core (150 um)
    height   170 ;           // The waveguide plane sits BELOW the cavity, so the
    material GLASS ;         // coolant becomes a thermal guard between the dies and
                             // the optics. Split this layer when photonics is added.

// ============================================================
// 6. DIES
// ============================================================
// Source sublayers are listed TOP -> BOTTOM, matching the stack convention.
//
// DIE_TOP holds GPU0 and MEM0. Both are flip-chip / face-down: the active
// surface points at the interposer and the backside faces the cold plate.
// -> source goes at the BOTTOM of this die.
//
// DIE_BOT holds LOGIC0, face-to-face Cu-Cu hybrid bonded to the DRAM die above.
// -> its active surface points UP, so source goes at the TOP of this die.
//
// If your 3D-ICE build rejects the multi-sublayer die grammar, fall back to
// "source 150 SILICON ;" / "source 100 SILICON ;". That costs ~0.4 K and
// reintroduces the Icepak source-depth ambiguity, so prefer the explicit form.

die DIE_TOP_D :
    layer  145 SILICON ;     // bulk Si, backside -> TIM -> cold plate
    source   5 SILICON ;     // active device layer at the flip-chip face
    // Mono3D k_z bounding run: change BOTH lines above to MONO3D_DRAM.

die DIE_BOT_D :
    source   5 SILICON ;     // active face UP, at the hybrid bond
    layer   95 SILICON ;     // bulk Si below

// ============================================================
// 7. STACK  (top -> bottom)
// ============================================================

stack :
    layer   CP_BASE     CP_BASE_L ;
    layer   TIM_TOP     TIM_L ;
    die     DIE_TOP     DIE_TOP_D  floorplan "die_top_S_v2.flp" ;
    layer   HB_IFACE    HB_L ;
    die     DIE_BOT     DIE_BOT_D  floorplan "die_bot_S_v2.flp" ;
    layer   UBUMP       UBUMP_L ;
    layer   IPOSER_TGV  IPOSER_TGV_L ;
    layer   IPOSER_CAV  IPOSER_CAV_L ;    // <- becomes "channel IMCH ;"
    layer   IPOSER_CORE IPOSER_CORE_L ;

// ============================================================
// 8. SOLVER
// ============================================================

solver :
    steady ;
    initial temperature 300.0 ;
    numofcores 12 ;

// ============================================================
// 9. OUTPUTS
// ============================================================

output :
    Tflp( DIE_TOP, "outputs-adapt/S_v2_liquid_top_max.txt", maximum, final ) ;
    Tflp( DIE_TOP, "outputs-adapt/S_v2_liquid_top_avg.txt", average, final ) ;
    Tflp( DIE_TOP, "outputs-adapt/S_v2_liquid_top_min.txt", minimum, final ) ;
    Tflp( DIE_BOT, "outputs-adapt/S_v2_liquid_bot_max.txt", maximum, final ) ;
    Tflp( DIE_BOT, "outputs-adapt/S_v2_liquid_bot_avg.txt", average, final ) ;
    Tmap( DIE_TOP, "outputs-adapt/S_v2_liquid_top_tmap.txt", final ) ;
    Tmap( DIE_BOT, "outputs-adapt/S_v2_liquid_bot_tmap.txt", final ) ;
    // Cold-plate base map: shows how much spreading you are actually getting.
    // If CP_BASE is close to isothermal, the spreader is doing its job.
    Tmap( CP_BASE, "outputs-adapt/S_v2_liquid_cpbase_tmap.txt", final ) ;
    // Interposer top map: baseline for photonic thermal crosstalk later.
    Tmap( IPOSER_TGV, "outputs-adapt/S_v2_liquid_iposer_tmap.txt", final ) ;
