// ============================================================
// 3D-ICE Floorplan File: mem_die_S.flp
// Die: Memory die (150 um thick, LOGIC_MEM material)
// Configuration: Stratum-S S0 baseline, updated to mirror xPU geometry
//
// Chip canvas: 46600 um x 34500 um
// Active component:
//   MEM0 / Mono3D DRAM tile : 10500 um x 11500 um = 120.75 mm^2, 102 W
//
// The memory die floorplan mirrors logic_die_S.flp so every x-y region
// has a corresponding thermal block. Only MEM0 is active. The region above
// the A6000-like xPU is passive because there is no Mono3D DRAM stacked over GPU0.
//
// Power density:
//   MEM0 : 102 W / 120.75 mm^2 = 84.5 W/cm^2
//   MEM0 + LOGIC0 stack power density = 142 W / 120.75 mm^2 = 117.6 W/cm^2
// ============================================================

// ---- Left column: passive fill above Mono3D DRAM ----

MEM_FILL_LEFT_TOP :
    position  0, 0 ;
    dimension 10500, 11500 ;
    power values 0 ;

// ---- Left column: active Mono3D DRAM tile above LOGIC0 ----

MEM0 :
    position  0, 11500 ;
    dimension 10500, 11500 ;
    power values 102 ;
    // Mono3D DRAM tile. Paper peak memory contribution is ~101.86 W;
    // 102 W keeps continuity with the existing Stratum-S ptrace baseline.

// ---- Left column: passive fill below Mono3D DRAM ----

MEM_FILL_LEFT_BOT :
    position  0, 23000 ;
    dimension 10500, 11500 ;
    power values 0 ;

// ---- xPU column: passive fill above GPU region ----

MEM_FILL_GPU_TOP :
    position  10500, 0 ;
    dimension 22500, 3300 ;
    power values 0 ;

// ---- Passive memory-die region above A6000-like xPU ----

MEM_ABOVE_GPU :
    position  10500, 3300 ;
    dimension 22500, 27900 ;
    power values 0 ;

// ---- xPU column: passive fill below GPU region ----

MEM_FILL_GPU_BOT :
    position  10500, 31200 ;
    dimension 22500, 3300 ;
    power values 0 ;

// ---- Right passive fill ----

MEM_FILL_RIGHT :
    position  33000, 0 ;
    dimension 13600, 34500 ;
    power values 0 ;
