// ============================================================
// 3D-ICE Floorplan File: logic_die_S.flp
// Die: Logic die (100 um thick, LOGIC_MEM material)
// Configuration: Stratum-S S0 baseline, updated A6000-like GA102 xPU
//
// Chip canvas: 46600 um x 34500 um
// Active components:
//   LOGIC0 / NMP logic tile : 10500 um x 11500 um = 120.75 mm^2, 40 W
//   GPU0 / A6000-like xPU  : 22500 um x 27900 um = 627.75 mm^2, 300 W
//
// xPU dimension rationale:
//   David estimate: 22.5 mm x 27.9 mm from GA102 die-shot aspect ratio.
//   NVIDIA official GA102 die area: 628.4 mm^2.
//   This floorplan area: 22.5*27.9 = 627.75 mm^2, within ~0.1% of official area.
//
// Power density:
//   GPU0   : 300 W / 627.75 mm^2  = 47.8 W/cm^2
//   LOGIC0 :  40 W / 120.75 mm^2  = 33.1 W/cm^2
//
// Layout:
//   x=0..10500       : left Mono3D/NMP column
//   x=10500..33000   : A6000-like xPU column
//   x=33000..46600   : right passive fill
//   GPU0 is vertically centered: y=3300..31200.
//   LOGIC0 remains centered in the left column: y=11500..23000.
// ============================================================

// ---- Left column: passive fill above NMP ----

FILL_LEFT_TOP :
    position  0, 0 ;
    dimension 10500, 11500 ;
    power values 0 ;

// ---- Left column: NMP logic tile under Mono3D DRAM ----

LOGIC0 :
    position  0, 11500 ;
    dimension 10500, 11500 ;
    power values 40 ;
    // NMP logic tile. Paper peak logic power is ~42.67 W;
    // 40 W keeps continuity with the existing Stratum-S ptrace baseline.

// ---- Left column: passive fill below NMP ----

FILL_LEFT_BOT :
    position  0, 23000 ;
    dimension 10500, 11500 ;
    power values 0 ;

// ---- xPU column: passive fill above GPU0 ----

FILL_GPU_TOP :
    position  10500, 0 ;
    dimension 22500, 3300 ;
    power values 0 ;

// ---- A6000-like GA102 xPU ----

GPU0 :
    position  10500, 3300 ;
    dimension 22500, 27900 ;
    power values 300 ;
    // A6000-like xPU modeled using David's GA102 die-shot aspect-ratio estimate.
    // Area = 22.5 mm x 27.9 mm = 627.75 mm^2, matching NVIDIA's 628.4 mm^2 GA102 area.
    // 300 W / 627.75 mm^2 = 47.8 W/cm^2.

// ---- xPU column: passive fill below GPU0 ----

FILL_GPU_BOT :
    position  10500, 31200 ;
    dimension 22500, 3300 ;
    power values 0 ;

// ---- Right passive fill ----

FILL_RIGHT :
    position  33000, 0 ;
    dimension 13600, 34500 ;
    power values 0 ;
