// ========================================================================
// 3D-ICE 4.0 -- hfp_chiplet_pinfin.stk
// HyFlexPIM v3 baseline unit: ONE lateral chiplet, glass-embedded,
// DIRECT-CONTACT Cu-PILLAR PIN-FIN interlayer cooling.
//
// CONTROLLED COMPARISON against hfp_chiplet_4rm_tgvwall.stk.
// Everything outside the cavity is byte-for-byte identical; ONLY the cavity
// architecture differs. Any temperature difference is attributable to the
// cooling architecture and nothing else.
//
// ========================================================================
// WHAT CHANGED FROM hyflexpim_glass_pinfin_cooled.stk, AND WHY
// ------------------------------------------------------------------------
//  1. FLOORPLAN 1790 W -> 140.70 W (hfp_chiplet_duty.flp).
//     1790 W summed the analog and digital PIM modules, which the author
//     confirmed are enabled SEQUENTIALLY. Duty-weighted at N=128 (410 us
//     analog + 16 us digital) the chip is 96.2% analog: 562.8 W system,
//     140.70 W per chiplet.
//
//  2. DIE 52.2 x 34.8 mm -> 26.1 x 17.4 mm. 1817 mm^2 exceeds a ~858 mm^2
//     reticle field, so the design must be four lateral chiplets.
//
//  3. DARCY VELOCITY 2.00e+06 -> 1.00e+06 um/s.  *** THE CRITICAL FIX ***
//     The old value over the full-die 52200 x 100 um frontal area implies
//     626 mL/min through ONE cavity -- the entire system pump budget in a
//     single chiplet, and 4x what the microchannel case uses. The new value
//     over the chiplet's 26100 x 100 um frontal area gives:
//         Q = 1.00 m/s x 26100 um x 100 um = 156.5 mL/min
//     which is EXACTLY the microchannel case's per-chiplet flow.
//     This is the matching invariant: EQUAL VOLUMETRIC FLOW. It is the
//     system-level constraint (1000 mL/min pump cap), it is unambiguous, and
//     it is the trade a packaging engineer actually makes. Consequence:
//     coolant temperature rise is 12.9 K in BOTH cases, so the comparison
//     isolates the local convective term alone.
//
//  4. GLASS k 1.00e-06 -> 1.40e-06. The microchannel model uses 1.4 W/(m.K)
//     (fused silica ~1.38). Must match or the comparison is confounded.
//
//  5. DIE ATTACH: INTERFACE 10 um / 2.0 -> SINTER_AG 20 um / 200 W/(m.K).
//     5.00 -> 0.10 mm^2K/W. The old interface was ~75% of the entire solid
//     conduction path and was silently dominating every result.
//
//  6. CU_SPREADER 10 um solid copper -> TGV_CAP 100 um (1.0, 1.0, 79.2).
//     The microchannel stack has a Cu-TGV composite cap between the die and
//     the cavity. Keeping a solid-Cu spreader here would hand the pin-fin
//     case a spreading advantage the microchannel case does not have.
//
//  7. ABF_LAYER 30 um / 0.3 -> GLASS_BASE 200 um / 1.4.
//     A misplaced ABF backside dielectric (k = 0.3) was the root cause of the
//     earlier 142 C photonic-stack failure: it stranded the active dissipator
//     on a buried low-k layer. It has no place under a bottom-adiabatic
//     interlayer-cooled stack.
//
//  8. DIE 'source 100' -> 50 + 5 source + 45 sublayers. Places the active
//     plane at mid-depth explicitly, matching the microchannel file and
//     removing the source-depth ambiguity in Icepak cross-validation.
//
//  9. PIN GEOMETRY UNCHANGED at d = 50 um, pitch = 100 um, inline, copper.
//     Deliberate: this is the ESTC-validated author vehicle, so the per-pin
//     hydraulic regime the author tuned is preserved. Solid fraction 0.196,
//     identical to the microchannel case's TGV composite f_Cu.
//     A d = 200 / pitch = 400 variant would match the TGV field 1:1 and is
//     worth a follow-up run -- but do not change two things at once.
//
// ------------------------------------------------------------------------
// GEOMETRIC COMPARISON OF THE TWO CAVITIES
// ------------------------------------------------------------------------
//                          microchannel 100/100    pin-fin d50/p100
//     solid fraction              0.50                  0.196
//     wetted area              904.8 mm^2            1443.3 mm^2
//     f_proj                      1.99                  3.18
//     pin/channel count            130                  45,414
//     via routing                1-D stripes          2-D freedom
//     via density                25/mm^2               ~6/mm^2
//
// Pin fins offer 1.6x the wetted area at 2.6x LESS solid material. The
// architectural cost is via density and routing regularity -- which is
// exactly the glass-volume contention trade this study is about.
//
// ------------------------------------------------------------------------
// CAUTION ON THE HTC CORRELATION -- READ BEFORE TRUSTING THE MAGNITUDE
// ------------------------------------------------------------------------
// Unlike microchannel-4RM, 3D-ICE computes the pin-fin HTC INTERNALLY from
// the Darcy velocity. This is an advantage (no external h needed, so this
// case is not blocked on the pending Icepak result) but the correlations as
// printed in the user guide are worth verifying:
//     inline    : 2.526e-5 / (v + 1.35)^0.64 + 1.533e-6
//     staggered : 2.526e-5 / (v + 1.35)^1.52 + 1.533e-6
// As transcribed, both DECREASE with velocity, and inline exceeds staggered
// at every velocity. Both are backwards from physical expectation (h should
// rise with v; staggered should out-perform inline through boundary-layer
// restart). They also evaluate to ~1e7 W/(m^2.K), roughly 100x any plausible
// single-phase water value.
// => Check the exponent signs and coefficient units in the guide, and treat
//    the ABSOLUTE temperatures from this run as provisional until resolved.
//    The comparison DESIGN is unaffected; only the magnitudes are.
// ========================================================================

material SILICON :
    thermal conductivity     1.30e-04 ;
    volumetric heat capacity 1.628e-12 ;

material GLASS :
    thermal conductivity     1.40e-06 ;
    volumetric heat capacity 1.60e-12 ;

material COPPER :
    thermal conductivity     4.00e-04 ;
    volumetric heat capacity 3.45e-12 ;

// Sintered-Ag die attach, 20 um / 200 W/(m.K) = 0.10 mm^2K/W.
material SINTER_AG :
    thermal conductivity     2.00e-04 ;
    volumetric heat capacity 2.50e-12 ;

// Cu-TGV / glass composite, f_Cu = 0.196:
//   k_z = 0.196(400) + 0.804(1.4) = 79.2 W/(m.K); lateral stays glass-like.
material TGV_GLASS_COMPOSITE :
    thermal conductivity     1.00e-06, 1.00e-06, 7.9204e-05 ;
    volumetric heat capacity 1.96e-12 ;

dimensions :
    chip length 26100, width 17400 ;
    cell length 100,   width 100 ;
    non-uniform false ;

// ------------------------------------------------------------------------
// PIN-FIN CAVITY -- the only thing that differs from the microchannel case
// ------------------------------------------------------------------------
// Cavity height 100 um, identical to the microchannel cavity, so the z-budget
// consumed by cooling is the same in both architectures.
//
// Darcy velocity is SUPERFICIAL: referenced to the full frontal area
// (26100 x 100 um), not to the open area between pins. Interstitial velocity
// is v_darcy / porosity = 1.00 / 0.804 = 1.24 m/s.

pinfin :
    height 100 ;
    pin diameter 50 ;
    pin pitch 100 ;
    pin distribution inline ;
    pin material COPPER ;
    darcy velocity 1.00e+06 ;          // 1.00 m/s -> 156.5 mL/min per chiplet
    coolant volumetric heat capacity 4.18e-12 ;
    coolant incoming temperature 300.0 ;

// SWEEP AXIS (one variable at a time):
//     darcy velocity  7.35e+05  ->  115 mL/min
//                     1.00e+06  ->  156.5 mL/min   [design point]
//                     1.28e+06  ->  200 mL/min
//                     1.60e+06  ->  250 mL/min  (system cap 1000 mL/min)
// These mirror the microchannel flow sweep exactly, so the two operating
// maps can be overlaid.
// Also worth running: pin distribution staggered, at the design point only.

layer GLASS_COVER_L :
    height   200 ;
    material GLASS ;

layer TGVS_L :
    height   100 ;
    material TGV_GLASS_COMPOSITE ;

layer ATTACH_L :
    height   20 ;
    material SINTER_AG ;

layer GLASS_BASE_L :
    height   200 ;
    material GLASS ;

die PIM_D :
    layer   50 SILICON ;
    source   5 SILICON ;
    layer   45 SILICON ;

// Top and bottom of the stack are ADIABATIC. The coolant is the only heat
// path -- interlayer cooling as primary extraction, and it keeps the
// comparison clean.
//
// Layer order is IDENTICAL to hfp_chiplet_4rm_tgvwall.stk. Only "channel MCH"
// becomes "channel PINS".

stack :
    layer   GLASS_COVER  GLASS_COVER_L ;
    channel PINS ;
    layer   TGVS         TGVS_L ;
    layer   ATTACH       ATTACH_L ;
    die     PIM          PIM_D  floorplan "/workspace/hyflexpim/hfp_chiplet_duty.flp" ;
    layer   GLASS_BASE   GLASS_BASE_L ;

solver :
    steady ;
    initial temperature 300.0 ;
    numofcores 2 ;

output :
    Tflp(     PIM,  "/workspace/hyflexpim/outputs/chiplet_pinfin_max.txt", maximum, final ) ;
    Tflp(     PIM,  "/workspace/hyflexpim/outputs/chiplet_pinfin_avg.txt", average, final ) ;
    Tmap(     PIM,  "/workspace/hyflexpim/outputs/chiplet_pinfin_tmap.txt", final ) ;
    Tmap(     PINS, "/workspace/hyflexpim/outputs/chiplet_pinfin_cav.txt", final ) ;
    // Outlet coolant temperature: MUST equal 300 + 12.9 = 312.9 K, exactly as
    // in the microchannel case. If it does not, the darcy velocity is not
    // delivering 156.5 mL/min and the comparison is invalid. Check this first.
    Tcoolant( PINS, "/workspace/hyflexpim/outputs/chiplet_pinfin_outlet.txt", maximum, final ) ;
