// ============================================================
// 3D-ICE Floorplan: hfp_duty.flp
// HyFlexPIM v2 -- DUTY-WEIGHTED steady state -- THE PRIMARY RUN.
// Stage schedule at N=128: 410 us analog + 16 us digital = 426 us.
// Duty: analog 96.2%, digital 3.8%.  Chip = 24*(0.962*22.337 + 0.038*52.256) = 562.8 W.
// Valid because the 426 us stage period is ~25x shorter than the 10-17 ms thermal
// time constant, so the die low-pass filters the phase square wave.
// Duty-weighted power DENSITY: analog 190.1 W/cm^2, digital 3.0 W/cm^2 (ratio 62x).
// ============================================================
// Chip 52200 x 34800 um = 1816.6 mm^2, 24 PUs in a 6x4 grid.
// Per PU: DIG 8700x7400 = 64.38 mm^2 (paper 64.05),
//         ANA 8700x1300 = 11.31 mm^2 (paper 11.24).
// Coolant flows +y: row 3 (y=0) is the INLET, row 0 (y=34800) is the OUTLET.
// Within each PU the ANA strip is DOWNSTREAM of its own DIG strip (layout L0).
//
// Powers: ANA 21.488 W/strip, DIG 1.962 W/strip
// Chip total = 24*(21.488 + 1.962) = 562.8 W
// q": ANA 190.0 W/cm^2, DIG 3.0 W/cm^2
// ============================================================

// ---- row 0  (y = 26100 .. 34800)   OUTLET
PU00_DIG :
    position  0, 26100 ;
    dimension 8700, 7400 ;
    power values 1.962 ;

PU00_ANA :
    position  0, 33500 ;
    dimension 8700, 1300 ;
    power values 21.488 ;

PU01_DIG :
    position  8700, 26100 ;
    dimension 8700, 7400 ;
    power values 1.962 ;

PU01_ANA :
    position  8700, 33500 ;
    dimension 8700, 1300 ;
    power values 21.488 ;

