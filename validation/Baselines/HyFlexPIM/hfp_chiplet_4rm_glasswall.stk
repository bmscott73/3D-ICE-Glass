// ========================================================================
// 3D-ICE 4.0 -- hfp_chiplet_4rm_glasswall.stk
// HyFlexPIM v3 baseline unit: ONE lateral chiplet, glass-embedded,
// interlayer microchannel cooling, microchannel-4RM model.
//
// CASE 1 -- BARE GLASS CHANNEL WALLS (microchannels alone).
// Predicted peak PU_ANA ~ 81.4 C. A MARGINAL pass against the 85 C RRAM limit.
//
// This is the honest 'microchannels alone' answer, and it only reaches a pass
// because three separate things were fixed at once:
//     wall 200 -> 100 um     projection 0.67 -> 1.00      (+50% h_eff)
//     analog strip inboard   removes the ~10 K edge penalty
//     sinter-Ag attach       R"_solid 6.65 -> 1.75 mm^2K/W
// With any one of those reverted it fails. 3.6 K of margin is not a result you
// would want to defend on its own -- run case 2.
// ========================================================================
// WHY 4RM AND NOT 2RM
// ------------------------------------------------------------------------
// 2RM takes EFFECTIVE PROJECTED heat transfer coefficients. Per the user guide:
//     HTC_top,eff    = (HTC_top    * ch_width + HTC_side * ch_height) / pitch
//     HTC_bottom,eff = (HTC_bottom * ch_width + HTC_side * ch_height) / pitch
// The sidewall contribution is folded onto the top and bottom faces, and the
// declared number is NOT a physical wall coefficient. Every HyFlexPIM run before
// this one declared 5.00e-08 as if it were physical, which was ~2.9x optimistic.
//
// 4RM takes PHYSICAL wall coefficients (side, top, bottom) and resolves wall and
// channel as separate cell columns itself. No hand projection, no chance of the
// same error twice, and -- more importantly -- the WALL is resolved explicitly.
// That matters here because wall conductivity is the largest lever we measured:
// Probe C (copper walls) gave 2.14x the effective conductance of glass walls.
//
// 3D-ICE does NOT compute h from the flow for microchannels. You must supply it.
// (It does compute h internally for PIN-FIN cavities via the Darcy-velocity
// correlations in the guide -- different cavity type, does not apply here.)
//
// ------------------------------------------------------------------------
// WHERE h COMES FROM, AND WHERE IT SHOULD COME FROM
// ------------------------------------------------------------------------
// Value below is Hausen combined-entry for water, evaluated at THIS geometry
// and flow: 130 channels, 156.5 mL/min, v = 2.01 m/s, Re = 225, Pr = 6.14,
// Gz = 7.93, Nu = 4.12, Dh = 100 um  ->  h = 24,949 W/(m^2.K).
//
// This is an INPUT, not a result, and it is the dominant remaining uncertainty.
// Ansys Icepak conjugate CFD COMPUTES h from the flow field. The cross-validation
// should therefore run Icepak -> 3D-ICE.
// Do not send Icepak an HTC; send it geometry, materials
// (with anisotropy), the power map, flow rate and inlet temperature.
//
// ------------------------------------------------------------------------
// GRID CONSTRAINT
// ------------------------------------------------------------------------
// 4RM tiles the cavity as wall|channel|wall|...|wall, so n_cols = 2*n_ch + 1.
// 26100 um at 100 um cells = 261 columns -> 130 channels, 131 walls, pitch 200.
// This forces equal channel and wall widths, which is a bonus: the effective
// projection rises from (100+100)/300 = 0.67 to (100+100)/200 = 1.00.
// ========================================================================

material SILICON :
    thermal conductivity     1.30e-04 ;
    volumetric heat capacity 1.628e-12 ;

material GLASS :
    thermal conductivity     1.40e-06 ;
    volumetric heat capacity 1.60e-12 ;

// Cu-TGV / glass composite, f_Cu = 0.196 (ESTC dia-100/200 um geometry):
//   k_z = 0.196*400 + 0.804*1.4 = 79.2 W/(m.K); lateral stays glass-like.
material TGV_GLASS_COMPOSITE :
    thermal conductivity     1.00e-06, 1.00e-06, 7.9204e-05 ;
    volumetric heat capacity 1.96e-12 ;

// Sintered-Ag die attach, 20 um / 200 W/(m.K) = 0.10 mm^2K/W.
// The original 10 um / 2.0 W/(m.K) interface was 5.00 mm^2K/W -- 75% of the
// entire solid path, and the cheapest 5 K in the whole model.
material SINTER_AG :
    thermal conductivity     2.00e-04 ;
    volumetric heat capacity 2.50e-12 ;

// cooling
microchannel 4rm :
    height 100 ;
    channel length 100 ;
    wall length 100 ;
    first wall length 100 ;
    last wall length 100 ;
    wall material GLASS ;
    coolant flow rate 156.5 ;
    coolant heat transfer coefficient
        side   2.49e-08,
        top    2.49e-08,
        bottom 2.49e-08 ;
    coolant volumetric heat capacity 4.18e-12 ;
    coolant incoming temperature 300.0 ;

// FLOW NOTE: 156.5 mL/min is ONE chiplet's share of a 626 mL/min system with four
// parallel manifolds. Each chiplet has its own 300 K inlet, so this single-chiplet
// model IS the system result -- no need to simulate all four.
// Coolant temperature rise = 140.7 W / 10.90 W/K = 12.9 K, identical to the
// monolithic case. Partitioning does not change it.
// Pump budget: dP = 0.89 bar here vs 5.29 bar monolithic. System cap 1000 mL/min
// corresponds to 250 mL/min per chiplet.

dimensions :
    chip length 26100, width 17400 ;
    cell length 100,   width 100 ;
    non-uniform false ;

layer GLASS_COVER_L :
    height   200 ;
    material GLASS ;

layer TGVS_L :
    height   100 ;
    material TGV_GLASS_COMPOSITE ;

layer ATTACH_L :
    height   20 ;
    material SINTER_AG ;

layer GLASS_BASE_L :
    height   200 ;
    material GLASS ;

die PIM_D :
    layer   50 SILICON ;
    source   5 SILICON ;
    layer   45 SILICON ;

// Top and bottom of the stack are ADIABATIC. The coolant is the only heat path.

stack :
    layer   GLASS_COVER  GLASS_COVER_L ;
    channel MCH ;
    layer   TGVS         TGVS_L ;
    layer   ATTACH       ATTACH_L ;
    die     PIM          PIM_D  floorplan "hfp_chiplet_duty.flp" ;
    layer   GLASS_BASE   GLASS_BASE_L ;

solver :
    steady ;
    initial temperature 300.0 ;
    numofcores 12 ;

output :
    Tflp( PIM, "outputs2/chiplet_glasswall_max.txt", maximum, final ) ;
    Tflp( PIM, "outputs2/chiplet_glasswall_avg.txt", average, final ) ;
    Tmap( PIM, "outputs2/chiplet_glasswall_tmap.txt", final ) ;
    Tmap( MCH, "outputs2/chiplet_glasswall_mch.txt", final ) ;
