// ============================================================================
// 3D-ICE 4.0 -- H200-scale check of the frozen Stratum-S liquid boundary
// ============================================================================
//
// PURPOSE
//   Test the exact Stratum-S liquid-cooling HTC and conduction chain against:
//
//   (1) Dogruoz et al.: complete maximum junction-to-inlet resistance of an
//       OEM Hopper/GH200 cold plate, approximately 0.036-0.040 K/W at 1 LPM.
//
//   (2) ToneCooling: H200 cold-plate contact-surface limit <65 C at a 38 C
//       water inlet and 700 W.  This is a plate-surface metric, not junction.
//
//   (3) Okamura et al.: operational H200 GPU-temperature envelope with coolant
//       varying from 34-44 C.  This is telemetry corroboration, not a matched
//       junction-peak experiment.
//
// VALIDATION RULE
//   The Stratum-S convective-side HTC is frozen at
//
//       h_conv = 4.08e-8 W/(um^2 K) = 40,800 W/(m^2 K).
//
//   It is not adjusted to force agreement with the 0.036-0.040 K/W reference.
//   The effective source-to-coolant resistance is an OUTPUT:
//
//       R_source,max-in = (Tmax(H200_GPU_EQUIV) - 300 K) / 700 W.
//
// AREA / CONDUCTANCE AUDIT
//   The global 3D-ICE top heat sink acts over the full Stratum-S canvas:
//
//       A_canvas = 39.6 mm x 31.8 mm = 1259.28 mm^2
//       G_conv   = h_conv * A_canvas = 51.381 W/K
//       R_conv   = 1/G_conv          = 0.01946 K/W
//
//   Therefore h_conv is only the fin/channel-side Robin boundary.  It must not
//   be described as the complete 0.039 K/W source-to-water resistance.  The
//   explicit Cu, TIM, silicon and spreading resistances complete the chain.
//
// LIMITED REBUILD RELATIVE TO h200_dlc_validation.stk
//   - UNCHANGED: h_conv, 300 K coolant, 39.6 x 31.8 mm canvas, 100 um grid,
//     2 mm total copper, 20 um TIM, 700 um total silicon and 700 W source.
//   - CHANGED: the 2 mm copper base is split into 1990 um bulk copper plus a
//     10 um copper contact-probe layer adjacent to the TIM.
//   - ADDED: contact-probe center temperature and full contact-plane map.
//
//   The probe center is 5 um inside the copper.  At 700 W its offset from the
//   true Cu/TIM interface is approximately 0.01 K and is negligible here.
//
// EXACT TEMPERATURE NORMALIZATION
//   All properties and h are constant, so no second run is needed:
//
//       source temperature at 40 C [C] = reported source temperature [K] - 260
//       plate temperature at 38 C [C]  = reported probe temperature  [K] - 262
//       source at coolant X C [C]       = reported source temperature [K]
//                                          - 300 + X
//
// EXPECTED CLOSURE
//   Because the total copper thickness and all boundary conditions are frozen,
//   the rebuilt source maximum should remain within about 0.02 K of 332.653 K
//   (72.653 C after normalization to a 40 C inlet).  A material change signals
//   an unintended stack or solver difference.
// ============================================================================

// ----------------------------------------------------------------------------
// 1. MATERIALS -- identical to the reduced-order Stratum-S/H200 check
// ----------------------------------------------------------------------------

material SILICON :
    thermal conductivity     1.30e-04 ;   // 130 W/(m K)
    volumetric heat capacity 1.75e-12 ;

material TIM :
    thermal conductivity     4.00e-06 ;   // 4 W/(m K)
    volumetric heat capacity 4.00e-12 ;

material COPPER :
    thermal conductivity     4.00e-04 ;   // 400 W/(m K)
    volumetric heat capacity 3.45e-12 ;

// ----------------------------------------------------------------------------
// 2. FROZEN STRATUM-S TOP LIQUID BOUNDARY
// ----------------------------------------------------------------------------

top heat sink :
    heat transfer coefficient 4.08e-08 ;
    temperature 300 ;

// The bottom remains adiabatic: no bottom heat sink is declared.

// ----------------------------------------------------------------------------
// 3. DIMENSIONS -- unchanged Stratum-S canvas and final-report grid
// ----------------------------------------------------------------------------

dimensions :
    chip length 39600, width 31800 ;
    cell length 100,   width 100 ;
    non-uniform false ;

// ----------------------------------------------------------------------------
// 4. COLD PLATE AND TIM
// ----------------------------------------------------------------------------
// Top-to-bottom order is fluid side -> device side.

layer CP_BULK_L :
    height   1990 ;
    material COPPER ;

layer CP_CONTACT_PROBE_L :
    height   10 ;
    material COPPER ;

layer TIM_L :
    height   20 ;
    material TIM ;

// ----------------------------------------------------------------------------
// 5. H200/HOPPER-SCALE EQUIVALENT DIE
// ----------------------------------------------------------------------------
// The active source is at the bottom face, as in the previous validation file.

die H200_EQUIV_D :
    layer  695 SILICON ;
    source   5 SILICON ;

// ----------------------------------------------------------------------------
// 6. STACK -- top to bottom
// ----------------------------------------------------------------------------

stack :
    layer CP_BULK          CP_BULK_L ;
    layer CP_CONTACT_PROBE CP_CONTACT_PROBE_L ;
    layer TIM_TOP          TIM_L ;
    die   H200_DIE         H200_EQUIV_D floorplan "h200_stratum_htc_probe.flp" ;

// ----------------------------------------------------------------------------
// 7. SOLVER
// ----------------------------------------------------------------------------

solver :
    steady ;
    initial temperature 300.0 ;
    numofcores 12 ;

// ----------------------------------------------------------------------------
// 8. OUTPUTS
// ----------------------------------------------------------------------------
// Scalar source outputs are directly usable for the Dogruoz/Okamura checks.
// The contact Tcell is a compact center/peak proxy; the contact Tmap is the
// authoritative maximum check for the ToneCooling plate-surface comparison.

output :
    Tflp( H200_DIE, "outputs2/h200_source_max.txt", maximum, final ) ;
    Tflp( H200_DIE, "outputs2/h200_source_avg.txt", average, final ) ;
    Tflp( H200_DIE, "outputs2/h200_source_min.txt", minimum, final ) ;
    Tmap( H200_DIE, "outputs2/h200_source_tmap.txt", final ) ;
    T( CP_CONTACT_PROBE, 19750, 15850, "outputs2/h200_plate_contact_center.txt", final ) ;
    Tmap( CP_CONTACT_PROBE, "outputs2/h200_plate_contact_tmap.txt", final ) ;

    // Optional spreading diagnostic on the fluid-side copper bulk node.
    Tmap( CP_BULK,
          "outputs2/h200_cp_bulk_tmap.txt", final ) ;

