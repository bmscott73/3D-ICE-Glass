// ============================================================================
// H200/Hopper-scale reduced-order floorplan for frozen Stratum-S HTC validation
// ============================================================================
//
// This is an equivalent uniform 700 W Hopper logic source, not a proprietary
// NVIDIA package reconstruction.  The 26.0 x 31.2 mm source is centered on the
// unchanged 39.6 x 31.8 mm Stratum-S boundary canvas.
//
// Source area       = 811.2 mm^2
// Source heat flux  = 86.29 W/cm^2 at 700 W
// Canvas area       = 1259.28 mm^2
//
// All coordinates are in micrometres and align to the 100 um simulation grid.
// ============================================================================

FILL_LEFT :
    position  0, 0 ;
    dimension 6800, 31800 ;
    power values 0 ;

FILL_SOURCE_BOTTOM :
    position  6800, 0 ;
    dimension 26000, 300 ;
    power values 0 ;

H200_GPU_EQUIV :
    position  6800, 300 ;
    dimension 26000, 31200 ;
    power values 700 ;

FILL_SOURCE_TOP :
    position  6800, 31500 ;
    dimension 26000, 300 ;
    power values 0 ;

FILL_RIGHT :
    position  32800, 0 ;
    dimension 6800, 31800 ;
    power values 0 ;

