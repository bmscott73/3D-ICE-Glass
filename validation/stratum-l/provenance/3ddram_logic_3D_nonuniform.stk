    // Tflp( LOG_DIE, "/workspace/mono3d_dram/outputs/transient_out_logic_tflp_avg.txt", average, step) ;
    // Tflp( MEM_DIE, "/workspace/mono3d_dram/outputs/transient_out_mem_tflp_avg.txt", average, step) ;
