    // Tmap( LOG_DIE, "/workspace/mono3d_dram/outputs/out_logic_tmap_nonuniform.txt", final) ;
    // Tmap( MEM_DIE, "/workspace/mono3d_dram/outputs/out_mem_tmap_nonuniform.txt", final) ;
    // Tflp( LOG_DIE, "/workspace/mono3d_dram/outputs/out_logic_tflp_nonuniform", maximum, final) ;
    // Tflp( MEM_DIE, "/workspace/mono3d_dram/outputs/out_mem_tflp_nonuniform.txt", maximum, final) ;
    // Tflp( LOG_DIE, "/workspace/mono3d_dram/outputs/out_logic_tflp_avg_nonuniform.txt", average, final) ;
    // Tflp( MEM_DIE, "/workspace/mono3d_dram/outputs/out_mem_tflp_avg_nonuniform.txt", average, final) ;
    // T3d ( "/workspace/mono3d_dram/outputs/out_3d_final_nonuniform.vtk", final) ;

