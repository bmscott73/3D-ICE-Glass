// 3D-ICE-Glass | cpo_3d.stk | generated from active statements
// SPDX-License-Identifier: CC-BY-4.0
// Canvas 40000 x 30000 um; grid 100 x 100 um.
// Source power: first 524.5 W; range 524.5..524.5 W; 1 sample(s).
// Top boundary: h=4.08e-08 W/um2K (40800 W/m2K), reference=300 K.
// Temperatures in emulator outputs are kelvin; time is seconds.
// Model data: CC-BY-4.0. References and observation planes: checkpoint README / docs/case-index.md.

material SILICON :
    thermal conductivity     1.30e-04 ;
    volumetric heat capacity 1.75e-12 ;

material COPPER :
    thermal conductivity     4.00e-04 ;
    volumetric heat capacity 3.45e-12 ;

material TIM :
    thermal conductivity     4.00e-06 ;
    volumetric heat capacity 4.00e-12 ;

material UBUMP_UF :
    thermal conductivity     2.00e-05 ;
    volumetric heat capacity 2.50e-12 ;

material GLASS :
    thermal conductivity     1.40e-06 ;
    volumetric heat capacity 1.60e-12 ;

material ABF :
    thermal conductivity     3.00e-07 ;
    volumetric heat capacity 1.50e-12 ;

material TGV_GLASS_COMPOSITE :
    thermal conductivity     1.00e-06, 1.00e-06, 7.9204e-05 ;
    volumetric heat capacity 1.96e-12 ;

top heat sink :
    heat transfer coefficient 4.08e-08 ;
    temperature 300 ;

dimensions :
    chip length 40000, width 30000 ;
    cell length 100,   width 100 ;
    non-uniform false ;

layer CP_BASE_L :
    height   2000 ;
    material COPPER ;

layer TIM_L :
    height   20 ;
    material TIM ;

layer UBUMP_L :
    height   40 ;
    material UBUMP_UF ;

layer TGV_L :
    height   110 ;
    material TGV_GLASS_COMPOSITE ;

layer ABF_L :
    height   30 ;
    material ABF ;

layer GLASS_CORE_L :
    height   300 ;
    material GLASS ;

die TIER1_D :
    layer  145 SILICON ;
    source   5 SILICON ;

die TIER2_D :
    source   5 SILICON ;
    layer   95 SILICON ;

die PIC_PLANE_D :
    source  20 GLASS ;

stack :
    layer CP_BASE   CP_BASE_L ;
    layer TIM_TOP   TIM_L ;
    die   TIER1     TIER1_D      floorplan "tier1_3d.flp" ;
    layer UBUMP     UBUMP_L ;
    die   TIER2     TIER2_D      floorplan "tier2_cpu.flp" ;
    layer TGV       TGV_L ;
    die   PIC_PLANE PIC_PLANE_D  floorplan "pic_plane.flp" ;
    layer ABF       ABF_L ;
    layer GLASS_CORE GLASS_CORE_L ;

solver :
    steady ;
    initial temperature 300.0 ;
    numofcores 12 ;

output :
    Tflp( PIC_PLANE, "outputs/cpo3d_pic_max.txt", maximum, final ) ;
    Tflp( PIC_PLANE, "outputs/cpo3d_pic_avg.txt", average, final ) ;
    Tflp( PIC_PLANE, "outputs/cpo3d_pic_min.txt", minimum, final ) ;
    Tflp( TIER1,     "outputs/cpo3d_t1_max.txt",  maximum, final ) ;
    Tflp( TIER2,     "outputs/cpo3d_t2_max.txt",  maximum, final ) ;
    Tmap( PIC_PLANE, "outputs/cpo3d_pic_tmap.txt", final ) ;
    Tmap( TIER1,     "outputs/cpo3d_t1_tmap.txt",  final ) ;
