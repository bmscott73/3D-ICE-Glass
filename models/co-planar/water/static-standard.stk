// ============================================================
// static-standard.stk -- Co-planar bridge, BRIDGE-STATIC branch
// STANDARD: bridge floorplans, OPT_IO 30.6 W + comb 0.3 W active. The paper's validated absolute number.
// Boundary: VALIDATED Stratum-S v2 Robin cold plate (H100 TTV -0.07 C, H200 probe,
// Stratum-S vs Icepak 0.5 K). No sense of flow: flow ordering is NOT measurable here.
// Package: xPU + Mono3D DRAM co-planar under one TIM + one 2 mm Cu base (Tejinder's
// planarization rule); NMP logic under the DRAM; bridge RDL in IPOSER_TGV; waveguides in
// the 20 um glass readout plane; bottom adiabatic (v2 rationale, <0.5% flows down).
// h = 4.08e-08 W/(um^2 K), reference 300 K.
// Generated by build_bridge_stks.py.
// ============================================================

material SILICON :
    thermal conductivity     1.30e-04 ;
    volumetric heat capacity 1.75e-12 ;
material TIM :
    thermal conductivity     4.00e-06 ;
    volumetric heat capacity 4.00e-12 ;
material COPPER :
    thermal conductivity     4.00e-04 ;
    volumetric heat capacity 3.45e-12 ;
material HYBRID_BOND :
    thermal conductivity     1.21e-04 ;
    volumetric heat capacity 2.14e-12 ;
material UBUMP_UF :
    thermal conductivity     2.00e-05 ;
    volumetric heat capacity 2.50e-12 ;
material GLASS :
    thermal conductivity     1.40e-06 ;
    volumetric heat capacity 1.60e-12 ;
material TGV_GLASS_COMPOSITE :
    thermal conductivity     1.00e-06, 1.00e-06, 7.9204e-05 ;
    volumetric heat capacity 1.96e-12 ;

top heat sink :
    heat transfer coefficient 4.08e-08 ;
    temperature 300 ;

dimensions :
    chip length 39600, width 31800 ;
    cell length 100,   width 100 ;
    non-uniform false ;

layer CP_BASE_L :            // 2 mm Cu cold-plate base (v2 spreader) -- UNCHANGED
    height   2000 ;
    material COPPER ;
layer TIM_L :
    height   20 ;
    material TIM ;
layer HB_L :
    height   1 ;
    material HYBRID_BOND ;
layer UBUMP_L :
    height   40 ;
    material UBUMP_UF ;
layer IPOSER_TGV_L :         // chip-side RDL + Cu-TGV field (bridge RDL lives here)
    height   110 ;
    material TGV_GLASS_COMPOSITE ;
layer IPOSER_CAV_L :         // solid glass in this package: NO interlayer cavity
    height   100 ;
    material GLASS ;
layer IPOSER_CORE_L :        // structural glass core. v2 had 170 here; 20 um moved to PIC_PLANE
    height   150 ;
    material GLASS ;

die DIE_TOP_D :
    layer  145 SILICON ;
    source   5 SILICON ;
die DIE_BOT_D :
    source   5 SILICON ;
    layer   95 SILICON ;
die PIC_PLANE_D :            // glass readout plane (pic-sohrab pattern): markers + comb only
    source  20 GLASS ;

stack :
    layer   CP_BASE     CP_BASE_L ;
    layer   TIM_TOP     TIM_L ;
    die     DIE_TOP     DIE_TOP_D  floorplan "die_top_bridge_memW.flp" ;
    layer   HB_IFACE    HB_L ;
    die     DIE_BOT     DIE_BOT_D  floorplan "die_bot_bridge_memW.flp" ;
    layer   UBUMP       UBUMP_L ;
    layer   IPOSER_TGV  IPOSER_TGV_L ;
    layer   IPOSER_CAV  IPOSER_CAV_L ;
    die     PIC_PLANE   PIC_PLANE_D floorplan "pic_plane_bridge_memW.flp" ;
    layer   IPOSER_CORE IPOSER_CORE_L ;

solver :
    steady ;
    initial temperature 300.0 ;
    numofcores 12 ;

output :
    Tflp( DIE_TOP,   "outputs-bridge-std/static-standard_top_max.txt", maximum, final ) ;
    Tflp( DIE_TOP,   "outputs-bridge-std/static-standard_top_avg.txt", average, final ) ;
    Tflp( DIE_BOT,   "outputs-bridge-std/static-standard_bot_max.txt", maximum, final ) ;
    Tflp( PIC_PLANE, "outputs-bridge-std/static-standard_pic_max.txt", maximum, final ) ;
    Tflp( PIC_PLANE, "outputs-bridge-std/static-standard_pic_min.txt", minimum, final ) ;
    Tflp( PIC_PLANE, "outputs-bridge-std/static-standard_pic_avg.txt", average, final ) ;
    Tmap( DIE_TOP,   "outputs-bridge-std/static-standard_top_tmap.txt", final ) ;
    Tmap( DIE_BOT,   "outputs-bridge-std/static-standard_bot_tmap.txt", final ) ;
    Tmap( PIC_PLANE, "outputs-bridge-std/static-standard_pic_tmap.txt", final ) ;
    Tmap( CP_BASE,   "outputs-bridge-std/static-standard_cpbase_tmap.txt", final ) ;
