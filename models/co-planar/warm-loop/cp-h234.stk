// 3D-ICE-Glass | cp-h234.stk | generated from active statements
// SPDX-License-Identifier: CC-BY-4.0
// Canvas 39600 x 31800 um; grid 100 x 100 um.
// Source power: first 405.27 W; range 405.27..405.27 W; 1 sample(s).
// Top boundary: h=2.34e-08 W/um2K (23400 W/m2K), reference=308 K.
// Temperatures in emulator outputs are kelvin; time is seconds.
// Model data: CC-BY-4.0. References and observation planes: checkpoint README / docs/case-index.md.

material SILICON :
    thermal conductivity     1.30e-04 ;
    volumetric heat capacity 1.75e-12 ;
material TIM :
    thermal conductivity     4.00e-06 ;
    volumetric heat capacity 4.00e-12 ;
material COPPER :
    thermal conductivity     4.00e-04 ;
    volumetric heat capacity 3.45e-12 ;
material HYBRID_BOND :
    thermal conductivity     1.21e-04 ;
    volumetric heat capacity 2.14e-12 ;
material UBUMP_UF :
    thermal conductivity     2.00e-05 ;
    volumetric heat capacity 2.50e-12 ;
material GLASS :
    thermal conductivity     1.40e-06 ;
    volumetric heat capacity 1.60e-12 ;
material TGV_GLASS_COMPOSITE :
    thermal conductivity     1.00e-06, 1.00e-06, 7.9204e-05 ;
    volumetric heat capacity 1.96e-12 ;

top heat sink :
    heat transfer coefficient 2.34e-08 ;
    temperature 308 ;

dimensions :
    chip length 39600, width 31800 ;
    cell length 100,   width 100 ;
    non-uniform false ;

layer CP_BASE_L :
    height   2000 ;
    material COPPER ;
layer CP_BASE2_L :
    height   2000 ;
    material COPPER ;
layer TIM_L :
    height   20 ;
    material TIM ;
layer HB_L :
    height   1 ;
    material HYBRID_BOND ;
layer UBUMP_L :
    height   40 ;
    material UBUMP_UF ;
layer IPOSER_TGV_L :
    height   110 ;
    material TGV_GLASS_COMPOSITE ;
layer IPOSER_CAV_L :
    height   100 ;
    material GLASS ;
layer IPOSER_CORE_L :
    height   150 ;
    material GLASS ;

die DIE_TOP_D :
    layer  145 SILICON ;
    source   5 SILICON ;
die DIE_BOT_D :
    source   5 SILICON ;
    layer   95 SILICON ;
die PIC_PLANE_D :
    source  20 GLASS ;
die DIE_MEM_D :
    source   5 SILICON ;
    layer   95 SILICON ;
die DIE_LOGIC_D :
    source   5 SILICON ;
    layer   95 SILICON ;

stack :
    layer   CP_BASE     CP_BASE_L ;
    layer   TIM_TOP     TIM_L ;
    die     DIE_TOP     DIE_TOP_D  floorplan "die_top_bridge.flp" ;
    layer   HB_IFACE    HB_L ;
    die     DIE_BOT     DIE_BOT_D  floorplan "die_bot_bridge.flp" ;
    layer   UBUMP       UBUMP_L ;
    layer   IPOSER_TGV  IPOSER_TGV_L ;
    layer   IPOSER_CAV  IPOSER_CAV_L ;
    die     PIC_PLANE   PIC_PLANE_D floorplan "pic_plane_bridge.flp" ;
    layer   IPOSER_CORE IPOSER_CORE_L ;

solver :
    steady ;
    initial temperature 300.0 ;
    numofcores 12 ;

output :
    Tflp( DIE_TOP, "outputs/cp-h234_die_top_max.txt", maximum, final ) ;
    Tflp( DIE_TOP, "outputs/cp-h234_die_top_avg.txt", average, final ) ;
    Tflp( DIE_BOT, "outputs/cp-h234_die_bot_max.txt", maximum, final ) ;
    Tflp( DIE_BOT, "outputs/cp-h234_die_bot_avg.txt", average, final ) ;
    Tflp( PIC_PLANE, "outputs/cp-h234_pic_plane_max.txt", maximum, final ) ;
    Tflp( PIC_PLANE, "outputs/cp-h234_pic_plane_avg.txt", average, final ) ;
    Tflp( PIC_PLANE, "outputs/cp-h234_pic_plane_min.txt", minimum, final ) ;
    Tmap( DIE_TOP, "outputs/cp-h234_die_top_tmap.txt", final ) ;
    Tmap( DIE_BOT, "outputs/cp-h234_die_bot_tmap.txt", final ) ;
    Tmap( PIC_PLANE, "outputs/cp-h234_pic_plane_tmap.txt", final ) ;
