// ============================================================
// cp-h234.stk -- CO-PLANAR BRIDGE, warm-liquid envelope point
// Dow PG30 Dittus-Boelter fixed velocity x0.575 (property-derived severe). Existing static-standard (4.08e-8) and static-dell (3.14e-8) complete the band.
// Primary h = 2.34e-08 at 308 K. Offsets to other inlets are exact: T(T_in) = T + (T_in - 308).
// Floorplans identical to static-standard (comb 0 W).
// Generated by build_matrix.py.
// ============================================================

material SILICON :
    thermal conductivity     1.30e-04 ;
    volumetric heat capacity 1.75e-12 ;
material TIM :
    thermal conductivity     4.00e-06 ;
    volumetric heat capacity 4.00e-12 ;
material COPPER :
    thermal conductivity     4.00e-04 ;
    volumetric heat capacity 3.45e-12 ;
material HYBRID_BOND :
    thermal conductivity     1.21e-04 ;
    volumetric heat capacity 2.14e-12 ;
material UBUMP_UF :
    thermal conductivity     2.00e-05 ;
    volumetric heat capacity 2.50e-12 ;
material GLASS :
    thermal conductivity     1.40e-06 ;
    volumetric heat capacity 1.60e-12 ;
material TGV_GLASS_COMPOSITE :
    thermal conductivity     1.00e-06, 1.00e-06, 7.9204e-05 ;
    volumetric heat capacity 1.96e-12 ;

top heat sink :                      // PRIMARY: direct-to-chip liquid plate, ref = coolant inlet
    heat transfer coefficient 2.34e-08 ;
    temperature 308 ;

dimensions :
    chip length 39600, width 31800 ;
    cell length 100,   width 100 ;
    non-uniform false ;

layer CP_BASE_L :            // 2 mm Cu base of the PRIMARY liquid plate; h on its OUTER face
    height   2000 ;
    material COPPER ;
layer CP_BASE2_L :           // 2 mm Cu SPREADER coupling the memory tier to the air sink
    height   2000 ;
    material COPPER ;
layer TIM_L :
    height   20 ;
    material TIM ;
layer HB_L :
    height   1 ;
    material HYBRID_BOND ;
layer UBUMP_L :
    height   40 ;
    material UBUMP_UF ;
layer IPOSER_TGV_L :
    height   110 ;
    material TGV_GLASS_COMPOSITE ;
layer IPOSER_CAV_L :
    height   100 ;
    material GLASS ;
layer IPOSER_CORE_L :
    height   150 ;
    material GLASS ;

die DIE_TOP_D :
    layer  145 SILICON ;
    source   5 SILICON ;
die DIE_BOT_D :
    source   5 SILICON ;
    layer   95 SILICON ;
die PIC_PLANE_D :
    source  20 GLASS ;
die DIE_MEM_D :
    source   5 SILICON ;
    layer   95 SILICON ;
die DIE_LOGIC_D :
    source   5 SILICON ;
    layer   95 SILICON ;

stack :
    layer   CP_BASE     CP_BASE_L ;
    layer   TIM_TOP     TIM_L ;
    die     DIE_TOP     DIE_TOP_D  floorplan "die_top_bridge.flp" ;
    layer   HB_IFACE    HB_L ;
    die     DIE_BOT     DIE_BOT_D  floorplan "die_bot_bridge.flp" ;
    layer   UBUMP       UBUMP_L ;
    layer   IPOSER_TGV  IPOSER_TGV_L ;
    layer   IPOSER_CAV  IPOSER_CAV_L ;
    die     PIC_PLANE   PIC_PLANE_D floorplan "pic_plane_bridge.flp" ;
    layer   IPOSER_CORE IPOSER_CORE_L ;

solver :
    steady ;
    initial temperature 300.0 ;
    numofcores 12 ;

output :
    Tflp( DIE_TOP, "outputs-matrix/cp-h234_die_top_max.txt", maximum, final ) ;
    Tflp( DIE_TOP, "outputs-matrix/cp-h234_die_top_avg.txt", average, final ) ;
    Tflp( DIE_BOT, "outputs-matrix/cp-h234_die_bot_max.txt", maximum, final ) ;
    Tflp( DIE_BOT, "outputs-matrix/cp-h234_die_bot_avg.txt", average, final ) ;
    Tflp( PIC_PLANE, "outputs-matrix/cp-h234_pic_plane_max.txt", maximum, final ) ;
    Tflp( PIC_PLANE, "outputs-matrix/cp-h234_pic_plane_avg.txt", average, final ) ;
    Tflp( PIC_PLANE, "outputs-matrix/cp-h234_pic_plane_min.txt", minimum, final ) ;
    Tmap( DIE_TOP, "outputs-matrix/cp-h234_die_top_tmap.txt", final ) ;
    Tmap( DIE_BOT, "outputs-matrix/cp-h234_die_bot_tmap.txt", final ) ;
    Tmap( PIC_PLANE, "outputs-matrix/cp-h234_pic_plane_tmap.txt", final ) ;
