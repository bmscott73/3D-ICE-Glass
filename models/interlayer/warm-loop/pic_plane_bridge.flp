// pic_plane_bridge_memW.flp -- 20 um GLASS readout plane inside the interposer (memory column at LOW x (west)).
// Pattern: pic-sohrab/pic_plane.flp. Powered: COMB_SRC 0.3 W (Hsueh Fig. 9 pump, all -> heat).
// 0 W REGION MARKERS (their Tflp is the temperature the optics see):
//   PIC_ROUTE  400 um lane from the comb, running under the FULL MEM0 tile to the seam
//   BRIDGE     the seam under the memory span (EMIB-style bridge footprint)
//   PIC_MRR    under OPT_IO: ring modulators / detectors
//   PIC_WG_S/N seam + OPT_IO lanes below/above the memory span
// Lateral gradient = max(PIC_ROUTE) - min(PIC_ROUTE), and PIC_MRR max - min.
// Generated by gen_bridge_flps.py.

FILL_0 :
    position  0, 0 ;
    dimension 39600, 2000 ;
    power values 0 ;

FILL_1 :
    position  0, 2000 ;
    dimension 13000, 8400 ;
    power values 0 ;

FILL_2 :
    position  16200, 2000 ;
    dimension 23400, 8400 ;
    power values 0 ;

FILL_3 :
    position  0, 10400 ;
    dimension 13000, 5100 ;
    power values 0 ;

FILL_4 :
    position  16200, 10400 ;
    dimension 23400, 5100 ;
    power values 0 ;

FILL_5 :
    position  16200, 15500 ;
    dimension 23400, 400 ;
    power values 0 ;

FILL_6 :
    position  0, 15900 ;
    dimension 13000, 5500 ;
    power values 0 ;

FILL_7 :
    position  16200, 15900 ;
    dimension 23400, 5500 ;
    power values 0 ;

FILL_8 :
    position  0, 21400 ;
    dimension 13000, 8400 ;
    power values 0 ;

FILL_9 :
    position  16200, 21400 ;
    dimension 23400, 8400 ;
    power values 0 ;

FILL_10 :
    position  0, 29800 ;
    dimension 39600, 2000 ;
    power values 0 ;

COMB_SRC :
    position  0, 15500 ;
    dimension 400, 400 ;
    power values 0 ; // comb src original 0.3

PIC_ROUTE :
    position  400, 15500 ;
    dimension 12600, 400 ;
    power values 0 ;

BRIDGE :
    position  13000, 10400 ;
    dimension 2000, 11000 ;
    power values 0 ;

PIC_MRR :
    position  15000, 10400 ;
    dimension 1200, 11000 ;
    power values 0 ;

PIC_WG_S :
    position  13000, 2000 ;
    dimension 3200, 8400 ;
    power values 0 ;

PIC_WG_N :
    position  13000, 21400 ;
    dimension 3200, 8400 ;
    power values 0 ;

