// 3D-ICE-Glass | emb-E2-std.stk | generated from active statements
// SPDX-License-Identifier: CC-BY-4.0
// Canvas 39600 x 31800 um; grid 100 x 100 um.
// Source power: first 694.61 W; range 694.61..694.61 W; 1 sample(s).
// Top boundary: h=4.08e-08 W/um2K (40800 W/m2K), reference=300 K.
// Embedded cooling 4rm: flow/velocity=237.2 mL/min; inlet=300.0 K; h=side 1.27e-08, top 1.27e-08, bottom 1.27e-08.
// Temperatures in emulator outputs are kelvin; time is seconds.
// Model data: CC-BY-4.0. References and observation planes: checkpoint README / docs/case-index.md.

material SILICON :
    thermal conductivity     1.30e-04 ;
    volumetric heat capacity 1.75e-12 ;
material SILICON_PIM :
    thermal conductivity     1.30e-04 ;
    volumetric heat capacity 1.628e-12 ;
material TIM :
    thermal conductivity     4.00e-06 ;
    volumetric heat capacity 4.00e-12 ;
material COPPER :
    thermal conductivity     4.00e-04 ;
    volumetric heat capacity 3.45e-12 ;
material HYBRID_BOND :
    thermal conductivity     1.21e-04 ;
    volumetric heat capacity 2.14e-12 ;
material UBUMP_UF :
    thermal conductivity     2.00e-05 ;
    volumetric heat capacity 2.50e-12 ;
material GLASS :
    thermal conductivity     1.40e-06 ;
    volumetric heat capacity 1.60e-12 ;
material TGV_GLASS_COMPOSITE :
    thermal conductivity     1.00e-06, 1.00e-06, 7.9204e-05 ;
    volumetric heat capacity 1.96e-12 ;
material SINTER_AG :
    thermal conductivity     2.00e-04 ;
    volumetric heat capacity 2.50e-12 ;

top heat sink :
    heat transfer coefficient 4.08e-08 ;
    temperature 300.0 ;

microchannel 4rm :
    height 100 ;
    channel length 100 ;
    wall length 100 ;
    first wall length 200 ;
    last wall length 100 ;
    wall material TGV_GLASS_COMPOSITE ;
    coolant flow rate 237.2 ;
    coolant heat transfer coefficient
        side   1.27e-08,
        top    1.27e-08,
        bottom 1.27e-08 ;
    coolant volumetric heat capacity 4.18e-12 ;
    coolant incoming temperature 300.0 ;

dimensions :
    chip length 39600, width 31800 ;
    cell length 100,   width 100 ;
    non-uniform false ;

layer CP_BASE_L :
    height   2000 ;
    material COPPER ;
layer TIM_L :
    height   20 ;
    material TIM ;
layer HB_L :
    height   1 ;
    material HYBRID_BOND ;
layer UBUMP_L :
    height   40 ;
    material UBUMP_UF ;
layer IPOSER_TGV_L :
    height   110 ;
    material TGV_GLASS_COMPOSITE ;
layer TGVS_L :
    height   100 ;
    material TGV_GLASS_COMPOSITE ;
layer ATTACH_L :
    height   20 ;
    material SINTER_AG ;
layer IPOSER_CORE_L :
    height   150 ;
    material GLASS ;

die DIE_TOP_D :
    layer  145 SILICON ;
    source   5 SILICON ;
die DIE_BOT_D :
    source   5 SILICON ;
    layer   95 SILICON ;
die DIE_EMB_D :
    layer   50 SILICON_PIM ;
    source    5 SILICON_PIM ;
    layer   45 SILICON_PIM ;
die PIC_PLANE_D :
    source  20 GLASS ;

stack :
    layer   CP_BASE     CP_BASE_L ;
    layer   TIM_TOP     TIM_L ;
    die     DIE_TOP     DIE_TOP_D   floorplan "die_top_bridge.flp" ;
    layer   HB_IFACE    HB_L ;
    die     DIE_BOT     DIE_BOT_D   floorplan "die_bot_bridge.flp" ;
    layer   UBUMP       UBUMP_L ;
    layer   IPOSER_TGV  IPOSER_TGV_L ;
    channel EMB_CH ;
    layer   TGVS        TGVS_L ;
    layer   ATTACH      ATTACH_L ;
    die     DIE_EMB     DIE_EMB_D   floorplan "die_emb_E2.flp" ;
    die     PIC_PLANE   PIC_PLANE_D floorplan "pic_plane_bridge.flp" ;
    layer   IPOSER_CORE IPOSER_CORE_L ;

solver :
    steady ;
    initial temperature 300.0 ;
    numofcores 12 ;

output :
    Tflp( DIE_TOP, "outputs/emb-E2-std_die_top_max.txt", maximum, final ) ;
    Tflp( DIE_TOP, "outputs/emb-E2-std_die_top_ave.txt", average, final ) ;
    Tflp( DIE_TOP, "outputs/emb-E2-std_die_top_min.txt", minimum, final ) ;
    Tflp( DIE_BOT, "outputs/emb-E2-std_die_bot_max.txt", maximum, final ) ;
    Tflp( DIE_BOT, "outputs/emb-E2-std_die_bot_ave.txt", average, final ) ;
    Tflp( DIE_BOT, "outputs/emb-E2-std_die_bot_min.txt", minimum, final ) ;
    Tflp( DIE_EMB, "outputs/emb-E2-std_die_emb_max.txt", maximum, final ) ;
    Tflp( DIE_EMB, "outputs/emb-E2-std_die_emb_ave.txt", average, final ) ;
    Tflp( DIE_EMB, "outputs/emb-E2-std_die_emb_min.txt", minimum, final ) ;
    Tflp( PIC_PLANE, "outputs/emb-E2-std_pic_plane_max.txt", maximum, final ) ;
    Tflp( PIC_PLANE, "outputs/emb-E2-std_pic_plane_ave.txt", average, final ) ;
    Tflp( PIC_PLANE, "outputs/emb-E2-std_pic_plane_min.txt", minimum, final ) ;
    Tmap( DIE_TOP, "outputs/emb-E2-std_die_top_tmap.txt", final ) ;
    Tmap( DIE_EMB, "outputs/emb-E2-std_die_emb_tmap.txt", final ) ;
    Tmap( PIC_PLANE, "outputs/emb-E2-std_pic_plane_tmap.txt", final ) ;
    Tmap( CP_BASE, "outputs/emb-E2-std_cp_base_tmap.txt", final ) ;
    Tmap( EMB_CH, "outputs/emb-E2-std_emb_ch_tmap.txt", final ) ;
