// ============================================================
// emb-E2-std.stk -- COST-AWARE INTERLAYER-COOLING GLASS PACKAGE, config E2
// STANDARD: validated water plate + validated water cavity, 300 K. The capacity baseline.
//
// D2C plate | Cu base | TIM | xPU + OPT_IO + Mono3D (co-planar bridge, VERBATIM)
//   | ubump | Cu-TGV RDL | GLASS uCH CAVITY | TGV | sinter-Ag | EMBEDDED TIER | PIC | glass
//
// Embedded tier: 2 Mono3D stack(s) = 289.34 W.
// Package total 694.61 W (41.7% embedded).
// Cavity: 197 channels, 237.2 mL/min, h = 1.27e-08, Cp = 4.18e-12, inlet 300.0 K.
//   Expected cavity outlet rise if it took ALL the heat: 42.03 K (Q*Cp = 16.52 W/K).
//   It will not: the top tier also sees the plate. Measured split is the point of the run.
// Plate: h_cp = 4.08e-08, reference 300.0 K.
// Grid 396 x 318 x 18 layers = 2,266,704 nodes. This is 29% above the largest stack that
//   has factored here (1.76M, flow-anchor at sane flow). See README if SuperLU_MT refuses.
// NOTE: per-channel heat load is 1.47 W vs 1.08 W at the anchor, so the coolant BULK
//   RISE, not the wall coefficient, is expected to bind at high N. That is a real capacity
//   limit and it is what makes flow the DTM lever.
// Generated by build_embedded_stks.py.
// ============================================================

material SILICON :
    thermal conductivity     1.30e-04 ;
    volumetric heat capacity 1.75e-12 ;
material SILICON_PIM :               // as in hfp_chiplet_4rm_tgvwall_v4.stk
    thermal conductivity     1.30e-04 ;
    volumetric heat capacity 1.628e-12 ;
material TIM :
    thermal conductivity     4.00e-06 ;
    volumetric heat capacity 4.00e-12 ;
material COPPER :
    thermal conductivity     4.00e-04 ;
    volumetric heat capacity 3.45e-12 ;
material HYBRID_BOND :
    thermal conductivity     1.21e-04 ;
    volumetric heat capacity 2.14e-12 ;
material UBUMP_UF :
    thermal conductivity     2.00e-05 ;
    volumetric heat capacity 2.50e-12 ;
material GLASS :
    thermal conductivity     1.40e-06 ;
    volumetric heat capacity 1.60e-12 ;
material TGV_GLASS_COMPOSITE :
    thermal conductivity     1.00e-06, 1.00e-06, 7.9204e-05 ;
    volumetric heat capacity 1.96e-12 ;
material SINTER_AG :                 // die attach, from the validated HyFlexPIM stack
    thermal conductivity     2.00e-04 ;
    volumetric heat capacity 2.50e-12 ;

top heat sink :
    heat transfer coefficient 4.08e-08 ;
    temperature 300.0 ;

microchannel 4rm :                   // VALIDATED glass uCH + Cu-TGV primitive
    height 100 ;
    channel length 100 ;
    wall length 100 ;
    first wall length 200 ;          // 200 + 197x100 + 196x100 + 100 = 39600 -> 197 channels
    last wall length 100 ;
    wall material TGV_GLASS_COMPOSITE ;
    coolant flow rate 237.2 ;               // TOTAL over 197 channels; per-channel 2.006 m/s
    coolant heat transfer coefficient
        side   1.27e-08,
        top    1.27e-08,
        bottom 1.27e-08 ;
    coolant volumetric heat capacity 4.18e-12 ;
    coolant incoming temperature 300.0 ;

dimensions :
    chip length 39600, width 31800 ;
    cell length 100,   width 100 ;   // FORCED: the 4rm cavity tiles the LENGTH at 100 um,
    non-uniform false ;              // and the HyFlexPIM analog strip is only 1300 um wide.

layer CP_BASE_L :            // 2 mm Cu cold-plate base; h_cp on its OUTER face
    height   2000 ;
    material COPPER ;
layer TIM_L :
    height   20 ;
    material TIM ;
layer HB_L :
    height   1 ;
    material HYBRID_BOND ;
layer UBUMP_L :
    height   40 ;
    material UBUMP_UF ;
layer IPOSER_TGV_L :         // chip-side RDL + Cu-TGV field; also the cavity's upper wall
    height   110 ;
    material TGV_GLASS_COMPOSITE ;
layer TGVS_L :               // VERBATIM from hfp_chiplet_4rm_tgvwall_v4.stk
    height   100 ;
    material TGV_GLASS_COMPOSITE ;
layer ATTACH_L :             // VERBATIM: sinter-Ag die attach
    height   20 ;
    material SINTER_AG ;
layer IPOSER_CORE_L :
    height   150 ;
    material GLASS ;

die DIE_TOP_D :
    layer  145 SILICON ;
    source   5 SILICON ;
die DIE_BOT_D :
    source   5 SILICON ;
    layer   95 SILICON ;
die DIE_EMB_D :              // embedded tier; source depth as in the validated PIM die
    layer   50 SILICON_PIM ;
    source    5 SILICON_PIM ;
    layer   45 SILICON_PIM ;
die PIC_PLANE_D :
    source  20 GLASS ;

stack :
    layer   CP_BASE     CP_BASE_L ;
    layer   TIM_TOP     TIM_L ;
    die     DIE_TOP     DIE_TOP_D   floorplan "die_top_bridge.flp" ;
    layer   HB_IFACE    HB_L ;
    die     DIE_BOT     DIE_BOT_D   floorplan "die_bot_bridge.flp" ;
    layer   UBUMP       UBUMP_L ;
    layer   IPOSER_TGV  IPOSER_TGV_L ;
    channel EMB_CH ;
    layer   TGVS        TGVS_L ;
    layer   ATTACH      ATTACH_L ;
    die     DIE_EMB     DIE_EMB_D   floorplan "die_emb_E2.flp" ;
    die     PIC_PLANE   PIC_PLANE_D floorplan "pic_plane_bridge.flp" ;
    layer   IPOSER_CORE IPOSER_CORE_L ;

solver :
    steady ;
    initial temperature 300.0 ;
    numofcores 12 ;

output :
    Tflp( DIE_TOP, "outputs-emb/emb-E2-std_die_top_max.txt", maximum, final ) ;
    Tflp( DIE_TOP, "outputs-emb/emb-E2-std_die_top_ave.txt", average, final ) ;
    Tflp( DIE_TOP, "outputs-emb/emb-E2-std_die_top_min.txt", minimum, final ) ;
    Tflp( DIE_BOT, "outputs-emb/emb-E2-std_die_bot_max.txt", maximum, final ) ;
    Tflp( DIE_BOT, "outputs-emb/emb-E2-std_die_bot_ave.txt", average, final ) ;
    Tflp( DIE_BOT, "outputs-emb/emb-E2-std_die_bot_min.txt", minimum, final ) ;
    Tflp( DIE_EMB, "outputs-emb/emb-E2-std_die_emb_max.txt", maximum, final ) ;
    Tflp( DIE_EMB, "outputs-emb/emb-E2-std_die_emb_ave.txt", average, final ) ;
    Tflp( DIE_EMB, "outputs-emb/emb-E2-std_die_emb_min.txt", minimum, final ) ;
    Tflp( PIC_PLANE, "outputs-emb/emb-E2-std_pic_plane_max.txt", maximum, final ) ;
    Tflp( PIC_PLANE, "outputs-emb/emb-E2-std_pic_plane_ave.txt", average, final ) ;
    Tflp( PIC_PLANE, "outputs-emb/emb-E2-std_pic_plane_min.txt", minimum, final ) ;
    Tmap( DIE_TOP, "outputs-emb/emb-E2-std_die_top_tmap.txt", final ) ;
    Tmap( DIE_EMB, "outputs-emb/emb-E2-std_die_emb_tmap.txt", final ) ;
    Tmap( PIC_PLANE, "outputs-emb/emb-E2-std_pic_plane_tmap.txt", final ) ;
    Tmap( CP_BASE, "outputs-emb/emb-E2-std_cp_base_tmap.txt", final ) ;
    Tmap( EMB_CH, "outputs-emb/emb-E2-std_emb_ch_tmap.txt", final ) ;
