// ============================================================
// d2air-4ms-735.stk -- warm-loop endpoint run, 308 K inlet.
// Dual-side hybrid, catalogued air sink at 4 m/s (h_eff = 3.453e-09); plate h = 0.735 h_w. BOTH references at 308 K, so no external inlet offset is applied.
// Generated by gen_endpoints.py; supersedes the retired 0.76 h_w condition.
// ============================================================
// d2air-4ms-735.stk -- ASYMMETRIC DUAL-SIDED (HYBRID LIQUID/AIR) COOLING, glass-separated
// Forced-air secondary, opt grade (0.2 K/W). Primary = validated water plate. Compare to d2-noplate (94.62 C) and d2-standard (52.46 C).
// liquid plate | Cu base | TIM | xPU(+OPT_IO) | ubump | GLASS (TGV + PIC plane) | ubump
//   | NMP logic | hybrid bond | Mono3D DRAM | TIM | Cu SPREADER | forced-air heat sink
// Liquid cooling is reserved for the 260.6 W xPU/optical tier; the 144.67 W memory tier is
// evaluated on a conventional forced-air finned sink. Tests whether thermal separation and
// demand-matched cooler allocation eliminate the second liquid plate, its manifold and pump.
// Primary h = 4.08e-08; secondary h_eff = 3.97e-09 (R_sa = 0.2 K/W); refs 300 K.
// Generated by build_matrix.py.
// ============================================================

material SILICON :
    thermal conductivity     1.30e-04 ;
    volumetric heat capacity 1.75e-12 ;
material TIM :
    thermal conductivity     4.00e-06 ;
    volumetric heat capacity 4.00e-12 ;
material COPPER :
    thermal conductivity     4.00e-04 ;
    volumetric heat capacity 3.45e-12 ;
material HYBRID_BOND :
    thermal conductivity     1.21e-04 ;
    volumetric heat capacity 2.14e-12 ;
material UBUMP_UF :
    thermal conductivity     2.00e-05 ;
    volumetric heat capacity 2.50e-12 ;
material GLASS :
    thermal conductivity     1.40e-06 ;
    volumetric heat capacity 1.60e-12 ;
material TGV_GLASS_COMPOSITE :
    thermal conductivity     1.00e-06, 1.00e-06, 7.9204e-05 ;
    volumetric heat capacity 1.96e-12 ;

top heat sink :                      // PRIMARY: direct-to-chip liquid plate, ref = coolant inlet
    heat transfer coefficient 2.999e-08 ;
    temperature 308 ;

// SECONDARY: forced-air finned aluminium heat sink on the memory tier, ref = APPROACH AIR.
// h_eff is an area-normalized sink-to-air conductance (R_sa = 0.2 K/W on the
// 1259.28 mm^2 footprint), NOT a raw air-film coefficient. Derived from a commercial
// straight-fin sink datasheet; the explicit TIM above is retained (conservative if the
// datasheet figure already includes one). No second liquid loop, no manifold, no added pump.
// Air reference is set equal to the liquid inlet here; see README for the split-reference
// zero-power run if the two references must differ.
bottom heat sink :
    heat transfer coefficient 3.453e-09 ;
    temperature 308 ;

dimensions :
    chip length 39600, width 31800 ;
    cell length 100,   width 100 ;
    non-uniform false ;

layer CP_BASE_L :            // 2 mm Cu base of the PRIMARY liquid plate; h on its OUTER face
    height   2000 ;
    material COPPER ;
layer CP_BASE2_L :           // 2 mm Cu SPREADER coupling the memory tier to the air sink
    height   2000 ;
    material COPPER ;
layer TIM_L :
    height   20 ;
    material TIM ;
layer HB_L :
    height   1 ;
    material HYBRID_BOND ;
layer UBUMP_L :
    height   40 ;
    material UBUMP_UF ;
layer IPOSER_TGV_L :
    height   110 ;
    material TGV_GLASS_COMPOSITE ;
layer IPOSER_CAV_L :
    height   100 ;
    material GLASS ;
layer IPOSER_CORE_L :
    height   150 ;
    material GLASS ;

die DIE_TOP_D :
    layer  145 SILICON ;
    source   5 SILICON ;
die DIE_BOT_D :
    source   5 SILICON ;
    layer   95 SILICON ;
die PIC_PLANE_D :
    source  20 GLASS ;
die DIE_MEM_D :
    source   5 SILICON ;
    layer   95 SILICON ;
die DIE_LOGIC_D :
    source   5 SILICON ;
    layer   95 SILICON ;

stack :
    layer   CP_BASE     CP_BASE_L ;
    layer   TIM_TOP     TIM_L ;
    die     DIE_TOP     DIE_TOP_D   floorplan "die_xpu_dual.flp" ;
    layer   UBUMP       UBUMP_L ;
    layer   IPOSER_TGV  IPOSER_TGV_L ;
    layer   IPOSER_CAV  IPOSER_CAV_L ;
    die     PIC_PLANE   PIC_PLANE_D floorplan "pic_plane_dual.flp" ;
    layer   IPOSER_CORE IPOSER_CORE_L ;
    layer   UBUMP_BOT   UBUMP_L ;
    die     DIE_LOGIC   DIE_LOGIC_D floorplan "die_logic_dual.flp" ;
    layer   HB_IFACE    HB_L ;
    die     DIE_MEM     DIE_MEM_D   floorplan "die_mem_dual.flp" ;
    layer   TIM_BOT     TIM_L ;
    layer   CP_BASE2    CP_BASE2_L ;

solver :
    steady ;
    initial temperature 308.0 ;
    numofcores 12 ;

output :
    Tflp( DIE_TOP, "outputs-matrix2/d2air-4ms-735_die_top_max.txt", maximum, final ) ;
    Tflp( DIE_TOP, "outputs-matrix2/d2air-4ms-735_die_top_avg.txt", average, final ) ;
    Tflp( DIE_LOGIC, "outputs-matrix2/d2air-4ms-735_die_logic_max.txt", maximum, final ) ;
    Tflp( DIE_LOGIC, "outputs-matrix2/d2air-4ms-735_die_logic_avg.txt", average, final ) ;
    Tflp( DIE_MEM, "outputs-matrix2/d2air-4ms-735_die_mem_max.txt", maximum, final ) ;
    Tflp( DIE_MEM, "outputs-matrix2/d2air-4ms-735_die_mem_avg.txt", average, final ) ;
    Tflp( PIC_PLANE, "outputs-matrix2/d2air-4ms-735_pic_plane_max.txt", maximum, final ) ;
    Tflp( PIC_PLANE, "outputs-matrix2/d2air-4ms-735_pic_plane_avg.txt", average, final ) ;
    Tflp( PIC_PLANE, "outputs-matrix2/d2air-4ms-735_pic_plane_min.txt", minimum, final ) ;
    Tmap( DIE_TOP, "outputs-matrix2/d2air-4ms-735_die_top_tmap.txt", final ) ;
    Tmap( DIE_LOGIC, "outputs-matrix2/d2air-4ms-735_die_logic_tmap.txt", final ) ;
    Tmap( DIE_MEM, "outputs-matrix2/d2air-4ms-735_die_mem_tmap.txt", final ) ;
    Tmap( PIC_PLANE, "outputs-matrix2/d2air-4ms-735_pic_plane_tmap.txt", final ) ;
