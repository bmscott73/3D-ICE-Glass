// PROVISIONING LEVEL: configuration TDP (BS 163840, 2 PFLOPS), 519.0 W per decode node, package 1367.2 W.
// Laboratory inlet 26.85 C, validated water plate.
// ============================================================
// pan-tdp.stk -- PanAgretti row neighbourhood: [HBM][xPU] [decode A] [decode B]
// STANDARD: validated water plate, 26.85 C. The baseline row.
// PanAgretti Fig. 2b vertical order:
//   cold plate | 2 mm Cu | TIM | DIE_MEM (M3D-DRAM x8, xPU, HBM) | Cu-Cu hybrid bond
//   | DIE_LOGIC (NMP + controllers + EIC drivers) | Cu-Cu bumps | DIE_PIC (PICs in glass
//   cavities BENEATH the logic dies) | PIC bumps | GIP RDL + SiN WG plane | GIP TGV | glass
// 449 x 122 x 14 layers = 766,892 nodes. Package 942.03 W. Plate h = 4.08e-08, ref 300 K.
// Not resolved (homogenised): EIC/PIC TSVs, individual bumps. Not modelled: off-panel
// laser, the other 61 decode nodes / 7 xPUs (adiabatic side walls = periodic neighbours).
// Generated by build_pan_stks.py.
// ============================================================

material SILICON :
    thermal conductivity     1.30e-04 ;
    volumetric heat capacity 1.75e-12 ;
material TIM :
    thermal conductivity     4.00e-06 ;
    volumetric heat capacity 4.00e-12 ;
material COPPER :
    thermal conductivity     4.00e-04 ;
    volumetric heat capacity 3.45e-12 ;
material HYBRID_BOND :               // Cu-Cu hybrid bond, DRAM <-> logic
    thermal conductivity     1.21e-04 ;
    volumetric heat capacity 2.14e-12 ;
material UBUMP_UF :                  // Cu-Cu bumps + underfill, logic <-> PIC and PIC <-> glass
    thermal conductivity     2.00e-05 ;
    volumetric heat capacity 2.50e-12 ;
material GLASS :
    thermal conductivity     1.40e-06 ;
    volumetric heat capacity 1.60e-12 ;
material TGV_GLASS_COMPOSITE :       // GIP TGV field, volume-fraction orthotropic
    thermal conductivity     1.00e-06, 1.00e-06, 7.9204e-05 ;
    volumetric heat capacity 1.96e-12 ;

top heat sink :
    heat transfer coefficient 4.08e-08 ;
    temperature 300 ;

dimensions :
    chip length 89800, width 24400 ;
    cell length 200,   width 200 ;
    non-uniform false ;

layer CP_BASE_L :
    height   2000 ;
    material COPPER ;
layer TIM_L :
    height   20 ;
    material TIM ;
layer HB_L :                  // EIC Cu-Cu ubump / hybrid bond (Fig. 2b)
    height   1 ;
    material HYBRID_BOND ;
layer CUCU_PIC_L :            // Cu-Cu bumps, logic die -> embedded PIC
    height   20 ;
    material UBUMP_UF ;
layer PIC_BUMP_L :            // PIC bumps -> GIP
    height   40 ;
    material UBUMP_UF ;
layer IPOSER_TGV_L :          // GIP TGV field
    height   110 ;
    material TGV_GLASS_COMPOSITE ;
layer IPOSER_CORE_L :
    height   150 ;
    material GLASS ;

die DIE_MEM_D :               // M3D-DRAM tiles + xPU + HBM
    layer  145 SILICON ;
    source   5 SILICON ;
die DIE_LOGIC_D :             // NMP + DRAM controllers + EIC drivers, one die
    source   5 SILICON ;
    layer   95 SILICON ;
die DIE_PIC_D :               // PIC chips in glass cavities; layer material GLASS (see flp header)
    source   5 GLASS ;
    layer   95 GLASS ;
die PIC_PLANE_D :             // GIP RDL + SiN waveguide plane
    source  20 GLASS ;

stack :
    layer   CP_BASE     CP_BASE_L ;
    layer   TIM_TOP     TIM_L ;
    die     DIE_MEM     DIE_MEM_D    floorplan "pan_mem_tdp.flp" ;
    layer   HB_DRAM     HB_L ;
    die     DIE_LOGIC   DIE_LOGIC_D  floorplan "pan_logic_tdp.flp" ;
    layer   CUCU_PIC    CUCU_PIC_L ;
    die     DIE_PIC     DIE_PIC_D    floorplan "pan_pic_die.flp" ;
    layer   PIC_BUMP    PIC_BUMP_L ;
    die     PIC_PLANE   PIC_PLANE_D  floorplan "pan_pic.flp" ;
    layer   IPOSER_TGV  IPOSER_TGV_L ;
    layer   IPOSER_CORE IPOSER_CORE_L ;

solver :
    steady ;
    initial temperature 300.0 ;
    numofcores 12 ;

output :
    Tflp( DIE_MEM, "outputs-pan/pan-tdp_die_mem_max.txt", maximum, final ) ;
    Tflp( DIE_MEM, "outputs-pan/pan-tdp_die_mem_ave.txt", average, final ) ;
    Tflp( DIE_MEM, "outputs-pan/pan-tdp_die_mem_min.txt", minimum, final ) ;
    Tflp( DIE_LOGIC, "outputs-pan/pan-tdp_die_logic_max.txt", maximum, final ) ;
    Tflp( DIE_LOGIC, "outputs-pan/pan-tdp_die_logic_ave.txt", average, final ) ;
    Tflp( DIE_LOGIC, "outputs-pan/pan-tdp_die_logic_min.txt", minimum, final ) ;
    Tflp( DIE_PIC, "outputs-pan/pan-tdp_die_pic_max.txt", maximum, final ) ;
    Tflp( DIE_PIC, "outputs-pan/pan-tdp_die_pic_ave.txt", average, final ) ;
    Tflp( DIE_PIC, "outputs-pan/pan-tdp_die_pic_min.txt", minimum, final ) ;
    Tflp( PIC_PLANE, "outputs-pan/pan-tdp_pic_plane_max.txt", maximum, final ) ;
    Tflp( PIC_PLANE, "outputs-pan/pan-tdp_pic_plane_ave.txt", average, final ) ;
    Tflp( PIC_PLANE, "outputs-pan/pan-tdp_pic_plane_min.txt", minimum, final ) ;
    Tmap( DIE_MEM, "outputs-pan/pan-tdp_die_mem_tmap.txt", final ) ;
    Tmap( DIE_LOGIC, "outputs-pan/pan-tdp_die_logic_tmap.txt", final ) ;
    Tmap( DIE_PIC, "outputs-pan/pan-tdp_die_pic_tmap.txt", final ) ;
    Tmap( PIC_PLANE, "outputs-pan/pan-tdp_pic_plane_tmap.txt", final ) ;
    Tmap( CP_BASE, "outputs-pan/pan-tdp_cp_base_tmap.txt", final ) ;
